import { useEffect, useState } from 'react'
import { ArrowRight, ArrowUpRight, CheckCircle2 } from 'lucide-react'
import { R } from '../routes'

const rotatingPhrases = [
  'IAS officer',
  'IPS officer',
  'IFS officer',
  'IRS officer',
  'civil servant',
  'nation builder',
  'change maker',
  'public servant',
  'future leader',
  'guardian of justice',
  'voice of the people',
  'agent of change',
]

export default function Hero() {
  const [phraseIndex, setPhraseIndex] = useState(0)

  const [showScrollCue, setShowScrollCue] = useState(false)
  useEffect(() => {
    const timer = window.setInterval(() => {
      setPhraseIndex((current) => (current + 1) % rotatingPhrases.length)
    }, 2500)

    return () => window.clearInterval(timer)
  }, [])

  useEffect(() => {
    let timer: number | undefined

    const clearCueTimer = () => {
      if (timer !== undefined) {
        window.clearTimeout(timer)
        timer = undefined
      }
    }

    const scheduleCue = () => {
      clearCueTimer()
      setShowScrollCue(false)

      // Only show after the visitor has returned to the top
      // and stopped scrolling for 3.5 seconds.
      if (window.scrollY <= 10) {
        timer = window.setTimeout(() => {
          if (window.scrollY <= 10) {
            setShowScrollCue(true)
          }
        }, 3500)
      }
    }

    const handleScroll = () => {
      // Hide immediately while scrolling; restart the delay
      // only when the viewport is back at the top.
      clearCueTimer()
      setShowScrollCue(false)

      if (window.scrollY <= 10) {
        timer = window.setTimeout(() => {
          if (window.scrollY <= 10) {
            setShowScrollCue(true)
          }
        }, 3500)
      }
    }

    scheduleCue()
    window.addEventListener('scroll', handleScroll, { passive: true })

    return () => {
      clearCueTimer()
      window.removeEventListener('scroll', handleScroll)
    }
  }, [])
  const currentPhrase = rotatingPhrases[phraseIndex]

  return (
    <section
      className="hero hero-reimagined hero-compact"
      id="top"
      aria-labelledby="hero-title"
    >
      <div className="wrap hero-compact-inner">
        <p className="hero-compact-eyebrow">
          <span aria-hidden="true" />
          YOUR JOURNEY. YOUR PURPOSE. YOUR FUTURE.
        </p>

        <h1 id="hero-title" className="hero-compact-title">
          Your personal guide
          <br />
          to every{' '}
          <span
            className="hero-compact-highlight"
            key={currentPhrase}
            aria-live="polite"
            aria-atomic="true"
          >
            {currentPhrase}
          </span>
        </h1>

        <p className="hero-compact-description">
          One destination for UPSC preparation, geography, practice tests
          and current affairs. Learn consistently. Prepare with purpose.
        </p>

        <div className="hero-compact-actions">
          <a className="hero-compact-button hero-compact-primary" href={R.notes}>
            Explore resources <ArrowRight size={18} aria-hidden="true" />
          </a>
          <a
            className="hero-compact-button hero-compact-secondary"
            href={R.geographyNotes}
          >
            Begin with Geography <ArrowUpRight size={17} aria-hidden="true" />
          </a>
        </div>

                        <div className="hero-bhaskar-strip">
  <style>{`
    .hero-bhaskar-strip {
      margin: 16px auto 0;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px 20px;
      padding: 13px 18px;
      border-top: 1px solid rgba(255,255,255,.13);
      border-bottom: 1px solid rgba(255,255,255,.13);
      background: rgba(7, 35, 27, .72);
      color: #fff;
      box-sizing: border-box;
    }
    .hero-bhaskar-kicker {
      color: #c6b47a;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.7px;
      text-transform: uppercase;
    }
    .hero-bhaskar-brand {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: #fff;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.35;
      transition: opacity .2s ease;
    }
    .hero-bhaskar-brand:hover { opacity: .8; }
    .hero-bhaskar-caption {
      display: block;
      color: #c6b47a;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .hero-startup-logo {
      display: block;
      width: 124px;
      max-width: 100%;
      height: 35px;
      object-fit: contain;
      background: #fff;
      border-radius: 3px;
      padding: 3px 6px;
      box-sizing: border-box;
    }
    .hero-bhaskar-divider {
      height: 26px;
      width: 1px;
      background: rgba(255,255,255,.2);
    }
    @media(max-width:650px) {
      .hero-bhaskar-strip { gap: 13px 18px; padding: 12px 8px; }
      .hero-bhaskar-kicker { width: 100%; text-align: center; }
      .hero-bhaskar-divider { display: none; }
    }
  `}            .hero-bhaskar-id-block {
              display: flex;
              flex-direction: column;
              align-items: flex-start;
              gap: 2px;
              cursor: default;
              pointer-events: none;
            }
            .hero-bhaskar-wordmark {
              display: flex;
              align-items: center;
              gap: 5px;
              color: #fff;
              font-size: 15px;
              font-weight: 800;
              letter-spacing: .6px;
              line-height: 1.15;
            }
            .hero-bhaskar-sun {
              color: #e8c76b;
              font-size: 13px;
            }
            .hero-bhaskar-id {
              color: #d7ddda;
              font-size: 9px;
              font-weight: 600;
              letter-spacing: .4px;
              line-height: 1.2;
              white-space: nowrap;
            }
</style>

  <span className="hero-bhaskar-kicker">Backed by</span>

  <div className="hero-bhaskar-brand hero-bhaskar-id-block" aria-label="BHASKAR ID">
  <span className="hero-bhaskar-wordmark">
    <span className="hero-bhaskar-sun" aria-hidden="true">✦</span>
    BHASKAR
  </span>
  <span className="hero-bhaskar-id">IN-1026-9561VP</span>
</div>

  <span className="hero-bhaskar-divider" aria-hidden="true" />

  <a
    className="hero-bhaskar-brand"
    href="https://www.startupindia.gov.in/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Visit the official Startup India website"
  >
    <img
      src="/images/startup-india-logo.png"
      alt="Startup India"
      width="150"
      height="48"
      style={{
        display: 'block',
        width: '112px',
        height: 'auto',
        maxHeight: '32px',
        objectFit: 'contain',
        background: '#ffffff',
        padding: '4px 8px',
        borderRadius: '3px',
        boxSizing: 'border-box'
      }}
    />
  </a>
</div>
<div className="hero-compact-proof" aria-label="Available resources">
          <span><CheckCircle2 size={15} aria-hidden="true" /> Study notes</span>
          <i aria-hidden="true" />
          <span>Geography & maps</span>
          <i aria-hidden="true" />
          <span>Practice tests</span>
          <i aria-hidden="true" />
          <span>Current affairs</span>
        </div>

        {showScrollCue && (
<button
          type="button"
          className="scroll-cue hero-compact-scroll"
          aria-label="Scroll to the next section"
          onClick={() => {
            document.getElementById('top')?.nextElementSibling?.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            })
          }}
        >
          <span className="scroll-cue-mouse" aria-hidden="true">
            <span className="scroll-cue-wheel" />
          </span>
          <span className="scroll-cue-chevron" aria-hidden="true" />
        </button>
      )}
      </div>
    </section>
  )
}