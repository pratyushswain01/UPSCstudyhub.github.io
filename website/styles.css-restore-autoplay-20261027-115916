/* UPSCHUB_MOTION_LAYER_V1 */

/* Smooth, restrained motion system */
html {
  scroll-behavior: smooth;
}

@keyframes ug-rise-in {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes ug-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes ug-soft-float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-7px); }
}

/* Hero: adapt these selectors to the existing class names */
.hero h1,
.hero h2,
.hero p,
.hero .eyebrow,
.hero .hero-actions,
.hero .hero-visual {
  animation: ug-rise-in 750ms cubic-bezier(.2,.7,.2,1) both;
}

.hero h1 { animation-delay: 80ms; }
.hero p { animation-delay: 180ms; }
.hero .hero-actions { animation-delay: 280ms; }
.hero .hero-visual { animation-delay: 360ms; }

/* Smooth interactions for common clickable surfaces */
a,
button {
  transition:
    color 180ms ease,
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 220ms ease,
    transform 220ms ease;
}

button:hover,
a[role="button"]:hover {
  transform: translateY(-2px);
}

/* Cards: use only for existing resource/card components */
.resource-card,
.feature-card,
.pathway-card,
.game-card,
.learning-card {
  transition:
    transform 240ms cubic-bezier(.2,.7,.2,1),
    box-shadow 240ms ease,
    border-color 240ms ease;
}

.resource-card:hover,
.feature-card:hover,
.pathway-card:hover,
.game-card:hover,
.learning-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 14px 32px rgba(20, 38, 56, 0.09);
}

/* Gentle visual movement where an existing hero illustration exists */
.hero .book-stack,
.hero .hero-illustration {
  animation: ug-soft-float 5s ease-in-out infinite;
}

/* Accessible fallback */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
