/* UPSC Gurukul premium typography */
@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root {
  --font-body: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
  --font-display: 'DM Serif Display', Georgia, serif;
}

html {
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body,
button,
input,
textarea,
select {
  font-family: var(--font-body);
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-display);
  font-weight: 400;
  letter-spacing: -0.025em;
}

button,
.btn,
nav,
.brand-runner-card strong,
.brand-runner-footer > span,
.eyebrow,
.brand-runner-eyebrow {
  font-family: var(--font-body);
}

.brand-runner-heading h2 {
  font-family: var(--font-display);
  font-weight: 400;
  letter-spacing: -0.035em;
}

.brand-runner-heading p,
.brand-runner-subtitle,
.brand-runner-footer small {
  font-family: var(--font-body);
}
/* END UPSC Gurukul premium typography */

/* ============ UPSC Gurukul homepage — design tokens ============ */
:root {
  --bg: #F7F4EC;
  --surface: #FFFDF8;
  --ink: #142638;
  --muted: #55626E;          /* slightly deeper than #64717B so body copy passes AA on ivory */
  --gold: #B38A45;
  --gold-ink: #7F5F27;       /* gold used for text on light surfaces */
  --line: #E3DED2;
  --navy: #102334;
  --navy-2: #17314a;
  --on-navy: #F3EFE4;
  --on-navy-muted: #B9C4CE;

  --serif: 'Newsreader', 'Source Serif 4', 'Iowan Old Style', Georgia, 'Times New Roman', serif;
  --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', Arial, sans-serif;

  --fs-body: 1.0625rem;
  --fs-small: 0.9375rem;
  --fs-h1: clamp(2.375rem, 1.6rem + 3.2vw, 4.125rem);
  --fs-h2: clamp(1.875rem, 1.35rem + 2.2vw, 3rem);
  --fs-h3: 1.25rem;

  --gutter: clamp(1.25rem, 4vw, 2.5rem);
  --max: 1200px;
  --sec: clamp(4rem, 8vw, 7.5rem);
  --header-h: 72px;
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-padding-top: calc(var(--header-h) + 12px); }
@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
body {
  margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans);
  font-size: var(--fs-body); line-height: 1.65; -webkit-font-smoothing: antialiased; overflow-x: hidden;
}
body.menu-open { overflow: hidden; }
img, svg { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
h1, h2, h3, p, ul, ol, figure { margin: 0; }
ul, ol { padding: 0; list-style: none; }
button { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 3px; }
.section-navy :focus-visible, .final :focus-visible { outline-color: #E4C589; }
.wrap { width: 100%; max-width: calc(var(--max) + var(--gutter) * 2); margin-inline: auto; padding-inline: var(--gutter); }
.skip { position: absolute; left: 1rem; top: -4rem; background: var(--ink); color: #fff; padding: .6rem 1rem; z-index: 100; border-radius: 4px; }
.skip:focus { top: 1rem; }

/* ============ Type ============ */
h1, h2, h3 { font-family: var(--serif); font-weight: 500; letter-spacing: -0.015em; text-wrap: balance; }
h1 { font-size: var(--fs-h1); line-height: 1.04; letter-spacing: -0.025em; text-wrap: pretty; }
h1 em { display: block; font-style: italic; color: var(--gold-ink); font-weight: 400; }
h2 { font-size: var(--fs-h2); line-height: 1.12; }
h3 { font-size: var(--fs-h3); line-height: 1.25; }
p { text-wrap: pretty; }
.eyebrow, .kicker { font-family: var(--sans); font-size: .8125rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-ink); }
.eyebrow { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.5rem; }
.eyebrow::before { content: ''; width: 2rem; height: 2px; background: var(--gold); }
.kicker { margin-bottom: 1rem; }
.kicker span { color: var(--ink); margin-right: .5rem; font-variant-numeric: tabular-nums; }
.kicker-light { color: #E4C589; } .kicker-light span { color: var(--on-navy); }
.lede { font-size: clamp(1.0625rem, .98rem + .45vw, 1.25rem); color: var(--muted); max-width: 34rem; margin-top: 1.5rem; line-height: 1.6; }
.sec-lede { color: var(--muted); margin-top: 1.25rem; max-width: 38rem; }
.fineprint { font-size: .875rem; color: var(--muted); margin-top: .9rem; max-width: 24rem; }
.fineprint-light { color: var(--on-navy-muted); }
.text-link { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--gold); font-weight: 500; }

/* ============ Buttons ============ */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 3rem; padding: .7rem 1.4rem;
  font-weight: 600; font-size: .9375rem; border-radius: 6px; border: 1px solid transparent; cursor: pointer;
  transition: background-color .2s, color .2s, border-color .2s, transform .2s; white-space: nowrap;
}
.btn svg { transition: transform .2s; }
.btn:hover svg { transform: translateX(3px); }
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--navy); color: #fff; }
.btn-primary:hover { background: #1b3a56; }
.btn-gold { background: var(--gold); color: #1a1405; }
.btn-gold:hover { background: #c49a52; }
.btn-ghost { border-color: var(--ink); color: var(--ink); background: transparent; }
.btn-ghost:hover { background: var(--ink); color: #fff; }
.btn-sm { min-height: 2.5rem; padding: .45rem 1.1rem; }
.btn-block { width: 100%; }
.link-quiet { display: inline-flex; align-items: center; gap: .35rem; font-weight: 500; border-bottom: 1px solid var(--gold); padding-bottom: 2px; transition: color .2s, border-color .2s; }
.link-quiet:hover { color: var(--gold-ink); }
.link-light { color: var(--on-navy); } .link-light:hover { color: #E4C589; }

/* ============ Header ============ */
.site-header { position: sticky; top: 0; z-index: 50; background: rgba(247,244,236,.96); border-bottom: 1px solid transparent; transition: border-color .25s, box-shadow .25s; }
.site-header.is-scrolled { border-bottom-color: var(--line); box-shadow: 0 1px 0 rgba(20,38,56,.04); }
.header-row { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
.wordmark { display: inline-flex; align-items: center; gap: .7rem; }
.wordmark-text { display: flex; flex-direction: column; line-height: 1; }
.wordmark-small { font-size: .6875rem; font-weight: 600; letter-spacing: .28em; color: var(--gold-ink); margin-bottom: .2rem; }
.wordmark-big { font-family: var(--serif); font-size: 1.55rem; font-weight: 600; letter-spacing: -0.02em; }
.nav-desktop { display: none; gap: clamp(1rem, 2vw, 2rem); }
.nav-desktop a { font-size: .9375rem; font-weight: 500; color: var(--ink); padding: .5rem 0; position: relative; }
.nav-desktop a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: .2rem; height: 2px; background: var(--gold); transition: right .25s ease; }
.nav-desktop a:hover::after { right: 0; }
.header-actions { display: flex; align-items: center; gap: .75rem; }
.menu-btn { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--line); background: var(--surface); border-radius: 6px; cursor: pointer; }
.mobile-menu { position: fixed; inset: var(--header-h) 0 0 0; background: var(--bg); padding: 1.25rem var(--gutter) 2rem; display: flex; flex-direction: column; gap: 1.5rem; overflow-y: auto; border-top: 1px solid var(--line); }
.mobile-menu[hidden] { display: none; }
.mobile-menu.is-open { animation: menu-in .22s ease both; }
.mobile-menu nav a { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: 1.5rem; }
@keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
@media (min-width: 1040px) {
  .nav-desktop { display: flex; }
  .menu-btn, .mobile-menu { display: none !important; }
}
@media (max-width: 420px) { .header-actions .btn-sm { display: none; } }

/* ============ Hero ============ */
.hero { padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.5rem); border-bottom: 1px solid var(--line); }
.hero-grid { display: grid; gap: clamp(2.25rem, 5vw, 4rem); align-items: center; }
.hero-copy h1 { max-width: 20ch; }
.cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 1.75rem; margin-top: 2rem; }
.hero-facts { display: flex; flex-wrap: wrap; gap: .4rem 0; margin-top: 2.25rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-size: .875rem; font-weight: 500; color: var(--muted); }
.hero-facts li:not(:last-child)::after { content: '/'; margin: 0 .8rem; color: var(--gold); }
.hero-visual { display: flex; flex-direction: column; gap: .8rem; }
.hero-visual figcaption { font-size: .8125rem; color: var(--muted); }
.folio { display: grid; grid-template-columns: 1fr; background: var(--navy); color: var(--on-navy); border-radius: 4px; overflow: hidden; box-shadow: 0 30px 60px -30px rgba(16,35,52,.45); }
.folio-label { font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: #E4C589; }
.folio-shelf { padding: 1.5rem 1.5rem 0; border-bottom: 1px solid rgba(255,255,255,.12); background: var(--navy-2); }
.spines { display: flex; align-items: flex-end; gap: 6px; height: 150px; margin-top: 1rem; border-bottom: 3px solid var(--gold); }
.spine { flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 2px 2px 0 0; overflow: hidden; }
.spine span { writing-mode: vertical-rl; transform: rotate(180deg); font-family: var(--serif); font-size: .8125rem; letter-spacing: .02em; white-space: nowrap; padding: .5rem 0; }
.spine-ivory { background: var(--bg); color: var(--ink); }
.spine-gold { background: var(--gold); color: #1a1405; }
.spine-line { background: #cbd3d9; color: var(--ink); }
.folio-list { padding: 1.5rem; }
.folio-list ol { margin-top: .5rem; }
.folio-list li a { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: .9rem; padding: .95rem 0; border-bottom: 1px solid rgba(255,255,255,.12); transition: padding-left .2s, color .2s; }
.folio-list li:last-child a { border-bottom: 0; }
.folio-list li a:hover { padding-left: .4rem; color: #E4C589; }
.folio-list .no { font-family: var(--serif); color: #E4C589; font-size: 1.05rem; font-variant-numeric: tabular-nums; }
.folio-list .t { display: flex; flex-direction: column; line-height: 1.35; }
.folio-list .t strong { font-family: var(--serif); font-weight: 500; font-size: 1.2rem; }
.folio-list .t span { font-size: .875rem; color: var(--on-navy-muted); }
@media (min-width: 640px) {
  .folio { grid-template-columns: 0.8fr 1.4fr; }
  .folio-shelf { border-bottom: 0; border-right: 1px solid rgba(255,255,255,.12); padding-bottom: 0; display: flex; flex-direction: column; }
  .spines { height: auto; flex: 1; min-height: 280px; }
}
@media (min-width: 960px) {
  .hero-grid { grid-template-columns: 1.02fr 1fr; }
  .folio-shelf { padding: 1.75rem 1.5rem 0; } .folio-list { padding: 1.75rem; }
}
@media (max-width: 639px) { .hero { padding-top: 1.5rem; } .hero-copy h1 { max-width: none; } .spines { height: 190px; } .spine span { font-size: .75rem; } }

/* ============ Sections ============ */
.section { padding-block: var(--sec); }
.section-tint { background: var(--surface); border-block: 1px solid var(--line); }
.section-navy { background: var(--navy); color: var(--on-navy); }
.section-navy .sec-lede { color: var(--on-navy-muted); }
.sec-head { max-width: 46rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
.split { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
.split-lead .btn { margin-top: 2rem; }
@media (min-width: 900px) {
  .split { grid-template-columns: 5fr 7fr; }
  .split-reverse { grid-template-columns: 7fr 5fr; }
}
@media (min-width: 900px) { .split-reverse .split-lead { order: 2; } }

/* index (01) — table-of-contents rows */
.index { border-top: 2px solid var(--ink); }
.index a { display: grid; grid-template-columns: 2.5rem 1fr; gap: .15rem 1rem; align-items: baseline; padding: 1.15rem 0; border-bottom: 1px solid var(--line); transition: background-color .2s, padding-left .2s; }
.index a svg { display: none; }
.index a:hover { background: var(--surface); padding-left: .75rem; }
.index-no { font-family: var(--serif); color: var(--gold-ink); font-variant-numeric: tabular-nums; }
.index-title { font-family: var(--serif); font-size: 1.4rem; font-weight: 500; line-height: 1.2; }
.index-text { grid-column: 2; color: var(--muted); font-size: var(--fs-small); }
@media (min-width: 860px) {
  .index { column-count: 2; column-gap: 4rem; border-top: 0; }
  .index li { break-inside: avoid; border-top: 2px solid var(--ink); }
  .index a { grid-template-columns: 2.5rem 1fr auto; }
  .index a svg { display: block; color: var(--gold-ink); align-self: center; grid-column: 3; grid-row: 1 / span 2; }
  .index-text { grid-column: 2; }
}

/* link rows */
.rows { border-top: 2px solid var(--ink); }
.rows a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); transition: padding-left .2s, color .2s; }
.rows a:hover { padding-left: .6rem; color: var(--gold-ink); }
.rows-main { display: flex; flex-direction: column; }
.rows-main strong { font-family: var(--serif); font-weight: 500; font-size: 1.3rem; line-height: 1.25; }
.rows-main span { color: var(--muted); font-size: var(--fs-small); }
.rows svg { flex: none; color: var(--gold-ink); }
.rows-big a { padding-block: 1.6rem; } .rows-big .rows-main strong { font-size: 1.6rem; }
.rows-light { border-top-color: rgba(255,255,255,.55); margin-top: 2rem; }
.rows-light a { border-bottom-color: rgba(255,255,255,.14); }
.rows-light a:hover { color: #E4C589; }
.rows-light .rows-main span { color: var(--on-navy-muted); }
.rows-light svg { color: #E4C589; }

/* geography */
.geo-grid { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: stretch; }
.geo-shelf { display: flex; align-items: flex-end; gap: 8px; min-height: 240px; padding: 1.5rem 1.5rem 0; background: var(--navy-2); border-radius: 4px; border-bottom: 4px solid var(--gold); }
.gspine { flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 2px 2px 0 0; }
.gspine span { writing-mode: vertical-rl; transform: rotate(180deg); font-family: var(--serif); font-size: clamp(.8rem, 1.6vw, 1rem); white-space: nowrap; padding: .6rem 0; }
.gspine-0 { background: var(--bg); color: var(--ink); } .gspine-1 { background: var(--gold); color: #1a1405; } .gspine-2 { background: #cbd3d9; color: var(--ink); }
.map-line { margin-top: 1.5rem; font-size: var(--fs-small); color: var(--on-navy-muted); }
.map-line span { color: #E4C589; font-weight: 600; margin-right: .35rem; }
@media (min-width: 900px) { .geo-grid { grid-template-columns: 5fr 7fr; } .geo-shelf { min-height: 420px; padding: 2rem 2rem 0; gap: 10px; } }

/* practice */
.practice { border-top: 2px solid var(--ink); }
.practice li { display: grid; gap: 1rem 2rem; align-items: center; padding: 1.75rem 0; border-bottom: 1px solid var(--line); }
.practice-no { font-family: var(--serif); font-size: 2.25rem; color: var(--gold); line-height: 1; font-variant-numeric: tabular-nums; }
.practice h3 { font-size: 1.5rem; }
.practice p { color: var(--muted); margin-top: .4rem; max-width: 40rem; }
.practice .btn { justify-self: start; }
@media (min-width: 860px) { .practice li { grid-template-columns: 4rem 1fr auto; } }

/* games */
.games-top { display: grid; gap: 1.5rem; align-items: start; }
.games-top .sec-head { margin-bottom: 0; }
@media (min-width: 900px) { .games-top { grid-template-columns: 1fr auto; } .games-cta .fineprint { margin-left: 0; } }
.subjects { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin: 2.5rem 0 1rem; font-family: var(--serif); font-size: clamp(1.25rem, 1rem + 1.4vw, 1.9rem); }
.subjects span:not(:last-child)::after { content: '·'; margin-left: 1.5rem; color: var(--gold); }
.modes { display: grid; gap: 0 3rem; border-top: 2px solid var(--ink); }
.modes li { display: grid; grid-template-columns: 1.5rem 1fr; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
.modes svg { color: var(--gold-ink); margin-top: .2rem; }
.modes h3 { font-size: 1.15rem; } .modes p { color: var(--muted); font-size: var(--fs-small); }
@media (min-width: 700px) { .modes { grid-template-columns: 1fr 1fr; border-top: 0; } .modes li { border-top: 1px solid var(--line); } .modes li:nth-child(-n+2) { border-top: 2px solid var(--ink); } }
@media (min-width: 1040px) { .modes { grid-template-columns: repeat(3, 1fr); } .modes li:nth-child(-n+3) { border-top: 2px solid var(--ink); } .modes li:nth-child(3) ~ li:nth-child(-n+3) { border-top: 1px solid var(--line); } }

/* app tour */
.app-grid { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
.steps { counter-reset: s; margin: 1.75rem 0 2rem; display: grid; gap: .75rem; }
.steps li { counter-increment: s; display: grid; grid-template-columns: 2rem 1fr; gap: .5rem; color: var(--on-navy); }
.steps li::before { content: counter(s); font-family: var(--serif); color: #E4C589; font-size: 1.1rem; }
.phones { display: flex; justify-content: center; align-items: flex-end; gap: clamp(.6rem, 2vw, 1.25rem); }
.phone { flex: 1; max-width: 190px; }
.phone-screen { aspect-ratio: 9 / 19; border: 2px solid rgba(255,255,255,.35); border-radius: 22px; background: var(--navy-2); display: grid; place-content: center; justify-items: center; gap: .6rem; padding: 1rem .6rem; text-align: center; color: var(--on-navy-muted); font-size: .8125rem; }
.phone figcaption { margin-top: .7rem; text-align: center; font-size: .8125rem; color: var(--on-navy-muted); }
.phone img { border-radius: 22px; border: 2px solid rgba(255,255,255,.35); }
.phone-1 { transform: translateY(-1.5rem); }
@media (min-width: 900px) { .app-grid { grid-template-columns: 1fr 1fr; } .phone-1 { transform: translateY(-2.5rem); } }

/* why */
.why { display: grid; gap: 2.5rem 3rem; }
.why li { border-top: 2px solid var(--ink); padding-top: 1.25rem; }
.why-no { font-family: var(--serif); font-size: 2.75rem; line-height: 1; color: var(--gold); display: block; margin-bottom: .8rem; }
.why h3 { margin-bottom: .6rem; } .why p { color: var(--muted); }
@media (min-width: 700px) { .why { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1040px) { .why { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; } }

/* faq */
.faq { border-top: 2px solid var(--ink); }
.faq-item { border-bottom: 1px solid var(--line); }
.faq-item h3 { font-size: inherit; }
.faq-item button { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; text-align: left; background: none; border: 0; padding: 1.3rem 0; cursor: pointer; font-family: var(--serif); font-size: 1.3rem; line-height: 1.3; }
.faq-item button svg { flex: none; color: var(--gold-ink); transition: transform .25s; }
.faq-item.is-open button svg { transform: rotate(180deg); }
.faq-item button:hover span { color: var(--gold-ink); }
.faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
.faq-panel > div { overflow: hidden; }
.faq-item.is-open .faq-panel { grid-template-rows: 1fr; }
.faq-panel p { color: var(--muted); padding: 0 2rem 1.4rem 0; max-width: 38rem; }
.faq-item:not(.is-open) .faq-panel { visibility: hidden; transition: grid-template-rows .3s ease, visibility 0s .3s; }

/* final + footer */
.final { background: var(--navy); color: var(--on-navy); padding-block: clamp(3.5rem, 7vw, 6rem); border-top: 4px solid var(--gold); }
.final-row { display: grid; gap: 2rem; align-items: center; }
.final h2 { max-width: 16ch; } .final p { color: var(--on-navy-muted); margin-top: 1rem; max-width: 32rem; }
.final-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 1.75rem; }
@media (min-width: 900px) { .final-row { grid-template-columns: 1fr auto; } }
.footer { background: var(--bg); padding-top: clamp(3rem, 6vw, 5rem); }
.footer-top { display: grid; gap: 2.5rem; padding-bottom: 3rem; }
.footer-brand p { color: var(--muted); font-size: var(--fs-small); max-width: 22rem; margin-top: 1.1rem; }
.footer-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; }
.footer h3 { font-family: var(--sans); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--gold-ink); margin-bottom: 1rem; }
.footer li + li { margin-top: .55rem; }
