.gurukul-cylinder-brand small { color:#a67b32; }
.gurukul-cylinder-tag { margin-top:4px; color:#8b682c; font-size:7px; font-weight:800; letter-spacing:.12em; }
.gurukul-cylinder-hero { position:relative; display:flex; flex-direction:column; gap:4px; min-height:111px; padding:12px 9px; overflow:hidden; border-radius:10px; color:#fff8e8; background:linear-gradient(140deg,#173a54,#0e2638 68%,#9c783d); }
.gurukul-cylinder-hero strong,.gurukul-cylinder-hero em { position:relative; z-index:1; font:18px/1.05 Georgia,serif; }
.gurukul-cylinder-hero em { color:#e9c875; }
.gurukul-cylinder-hero small { position:relative; z-index:1; max-width:128px; color:#e1e2df; font-size:7px; line-height:1.4; }
.gurukul-cylinder-orbit { position:absolute; right:0; bottom:-15px; color:rgba(229,199,131,.32); font-size:75px; }
.gurukul-cylinder-tiles { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:4px; }
.gurukul-cylinder-tiles > div { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; min-height:55px; padding:4px 1px; border:1px solid #e8deca; border-radius:7px; background:#fffdf8; }
.gurukul-cylinder-tiles b { color:#a67b32; font:15px Georgia,serif; }
.gurukul-cylinder-tiles small { color:#35495b; font-size:6px; text-align:center; }
.gurukul-cylinder-task-label { color:#203447; font:12px Georgia,serif; }
.gurukul-cylinder-task { display:flex; align-items:center; gap:7px; padding:8px 6px; border:1px solid #e6dcc8; border-radius:8px; background:#fffdf8; }
.gurukul-cylinder-task > span { display:grid; place-items:center; flex:0 0 25px; height:25px; border-radius:7px; color:#9a712c; background:#f2e6c9; }
.gurukul-cylinder-task > div { display:flex; flex-direction:column; gap:4px; min-width:0; }
.gurukul-cylinder-task b { overflow:hidden; font-size:7px; text-overflow:ellipsis; white-space:nowrap; }
.gurukul-cylinder-task small { color:#66717b; font-size:6px; line-height:1.3; }
.gurukul-cylinder-action { display:flex; justify-content:space-between; padding:8px 9px; border-radius:7px; color:#102638; background:#d9b66b; font-size:8px; font-weight:800; }
.gurukul-cylinder-nav { display:flex; justify-content:space-around; margin-top:auto; padding-top:7px; border-top:1px solid #e3dac8; }
.gurukul-cylinder-nav span { display:flex; flex-direction:column; align-items:center; gap:3px; font-size:12px; }
.gurukul-cylinder-nav small { font-size:6px; }
.gurukul-cylinder-floor { position:absolute; bottom:25px; width:72%; height:28px; border-radius:50%; background:rgba(0,0,0,.24); filter:blur(14px); }
.gurukul-cylinder-controls { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:15px; margin-top:4px; }
.gurukul-cylinder-controls > button { padding:9px 14px; border:1px solid rgba(230,199,121,.55); border-radius:24px; color:#f4dfac; background:transparent; cursor:pointer; font:inherit; font-size:.8rem; }
.gurukul-cylinder-controls > button:hover { color:#102638; background:#e6c779; }
.gurukul-cylinder-dots { display:flex; justify-content:center; gap:8px; }
.gurukul-cylinder-dots button { width:8px; height:8px; padding:0; border:0; border-radius:50%; background:#637585; cursor:pointer; }
.gurukul-cylinder-dots button.is-active { transform:scale(1.35); background:#e6c779; }
.gurukul-cylinder-caption { margin:13px 0 0; color:#e6c779; font: .9rem Georgia,serif; text-align:center; }
.gurukul-cylinder-controls button:focus-visible { outline:2px solid #e6c779; outline-offset:3px; }
@media (max-width:1050px) {
  .gurukul-cylinder-layout { grid-template-columns:1fr; gap:28px; }
  .gurukul-cylinder-copy { max-width:720px; }
  .gurukul-cylinder-stage { height:500px; }
}
@media (max-width:600px) {
  .gurukul-cylinder-stage { height:410px; perspective:900px; }
  .gurukul-cylinder-ring { --radius:180px; --card-width:160px; height:340px; }
  .gurukul-cylinder-card { height:340px; }
  .gurukul-cylinder-screen { gap:6px; padding:6px; }
  .gurukul-cylinder-hero { min-height:88px; padding:9px 7px; }
  .gurukul-cylinder-hero strong,.gurukul-cylinder-hero em { font-size:15px; }
  .gurukul-cylinder-tiles > div { min-height:45px; }
  .gurukul-cylinder-tiles b { font-size:12px; }
  .gurukul-cylinder-controls { gap:9px; }
  .gurukul-cylinder-controls > button { padding:8px 10px; }
}
@media (prefers-reduced-motion: reduce) {
  .gurukul-cylinder-ring { transition:none; }
}

/* UPSC Gurukul: continuous 3D cylinder */
.gurukul-cylinder-stage {
  overflow: hidden;
  position: relative;
  perspective: 1150px;
  isolation: isolate;
}

.gurukul-cylinder-ring {
  transform: translateY(-8px) rotateY(0deg) !important;
  transform-style: preserve-3d;
  animation: gurukul-cylinder-spin 32s linear infinite !important;
  animation-play-state: running !important;
  transition: none !important;
  will-change: transform;
}

.gurukul-cylinder-card {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.gurukul-cylinder-controls,
.gurukul-cylinder-dots {
  position: relative;
  z-index: 30;
  pointer-events: auto;
}

.gurukul-cylinder-controls button {
  cursor: pointer !important;
  pointer-events: auto !important;
  position: relative;
  z-index: 31;
  touch-action: manipulation;
}

.gurukul-cylinder-dots button {
  min-width: 12px;
  min-height: 12px;
  cursor: pointer !important;
}

.gurukul-cylinder-dots button:hover {
  background: #e6c779;
  transform: scale(1.35);
}

@keyframes gurukul-cylinder-spin {
  from { transform: translateY(-8px) rotateY(0deg); }
  to   { transform: translateY(-8px) rotateY(-360deg); }
}
