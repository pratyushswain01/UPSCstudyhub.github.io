}
function onScroll() { if (!ticking) { ticking = true; window.requestAnimationFrame(update); } }

/* ---------- wiring ---------- */
function wire() {
  var themeBtn = $('#themeBtn');
  themeBtn.addEventListener('click', function () { setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'); });
  $('#fsDown').addEventListener('click', function () { setFs(G.fs - 1); });
  $('#fsUp').addEventListener('click', function () { setFs(G.fs + 1); });
  $$('[data-quick-toggle]').forEach(function (b) { b.addEventListener('click', function () { setQuick(!G.quick); }); });
  $$('.js-complete').forEach(function (b) { b.addEventListener('click', toggleComplete); });
  $('#bmBtn').addEventListener('click', toggleBookmark);
  $('#printBtn').addEventListener('click', function () { window.print(); });

  menuBtn.addEventListener('click', function () { setDrawer(true); });
  $('#sideClose').addEventListener('click', function () { setDrawer(false); });
  scrim.addEventListener('click', function () { setDrawer(false); });
  var onMq = function () { if (mqDesk.matches) { side.classList.remove('is-open'); scrim.hidden = true; document.body.classList.remove('no-scroll'); menuBtn.setAttribute('aria-expanded', 'false'); } syncInert(); };
  if (mqDesk.addEventListener) mqDesk.addEventListener('change', onMq); else if (mqDesk.addListener) mqDesk.addListener(onMq);

  var sd = $('#searchDlg'), qi = $('#q');
  function openSearch() { openDlg(sd); qi.focus(); qi.select(); }
  $('#searchBtn').addEventListener('click', openSearch);
  $('#searchIcon').addEventListener('click', openSearch);
  $('#searchClose').addEventListener('click', function () { closeDlg(sd); });
  qi.addEventListener('input', debounce(function () { runSearch(qi.value); }, 120));
  sd.addEventListener('keydown', function (e) {
    var links = $$('#results a');
    if (e.key === 'ArrowDown' && links.length) { e.preventDefault(); var i = links.indexOf(document.activeElement); (links[i + 1] || links[0]).focus(); }
    else if (e.key === 'ArrowUp' && links.length) { e.preventDefault(); var j = links.indexOf(document.activeElement); if (j <= 0) qi.focus(); else links[j - 1].focus(); }
  });
  [sd, $('#notesDlg'), $('#libDlg')].forEach(function (d) { d.addEventListener('click', function (e) { if (e.target === d) closeDlg(d); }); });

  var nd = $('#notesDlg'), na = $('#notesArea');
  na.value = C.notes;
  var saveNotes = debounce(function () { C.notes = na.value; saveC(); renderProgress(); $('#notesState').textContent = S.ok ? 'Saved on this device.' : 'Browser storage is off, so this note will be lost when you close the tab.'; }, 400);
  na.addEventListener('input', function () { $('#notesState').textContent = 'Saving…'; saveNotes(); });
  $('#openNotes').addEventListener('click', function () { if (!mqDesk.matches) setDrawer(false, true); renderHlList(); $('#notesState').textContent = S.ok ? '' : 'Browser storage is off, so notes last only until you close the tab.'; openDlg(nd); });
  $('#notesClose').addEventListener('click', function () { closeDlg(nd); });
  var ld = $('#libDlg');
  $('#openLib').addEventListener('click', function () { if (!mqDesk.matches) setDrawer(false, true); renderLib(); openDlg(ld); });
  $('#libClose').addEventListener('click', function () { closeDlg(ld); });

  document.addEventListener('click', function (e) {
    var t = e.target.closest ? e.target.closest('.term') : null;
