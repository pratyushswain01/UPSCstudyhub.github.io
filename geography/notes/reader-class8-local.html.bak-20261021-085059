}
function renderHlList() {
  var ul = $('#hlList'); ul.replaceChildren();
  if (!C.highlights.length) { ul.append(el('li', { class: 'empty' }, 'No highlights yet. Select a sentence in the chapter and choose Highlight. It will appear here, and you can remove it any time.')); return; }
  C.highlights.forEach(function (h) {
    ul.append(el('li', null, el('span', null, '“' + h.text + '”'),
      el('span', { class: 'acts' },
        el('button', { class: 'link-btn', type: 'button', on: { click: function () { closeDlg($('#notesDlg')); goTo(h.el); } } }, 'Show in chapter'),
        el('button', { class: 'link-btn', type: 'button', on: { click: function () { removeHighlight(h.id); } } }, 'Remove'))));
  });
}

/* ---------- navigation helpers ---------- */
function goTo(id) {
  var t = document.getElementById(id) || document.querySelector('[data-hl="' + id + '"]');
  if (!t) return;
  if (G.quick && t.offsetParent === null) setQuick(false);
  var d = t.closest('details'); if (d) d.open = true;
  t.scrollIntoView({ block: 'center' });
  t.setAttribute('tabindex', '-1'); try { t.focus({ preventScroll: true }); } catch (e) {}
  t.classList.add('flash-hit'); setTimeout(function () { t.classList.remove('flash-hit'); }, 1900);
}

/* ---------- search ---------- */
function runSearch(raw) {
  var q = raw.trim(), out = $('#results'), status = $('#searchStatus');
  out.replaceChildren();
  if (q.length < 2) { status.textContent = 'Type at least two characters to search.'; return; }
  var ql = q.toLowerCase(), hits = [];
  INDEX.forEach(function (it) { var i = it.text.toLowerCase().indexOf(ql); if (i > -1) hits.push({ it: it, i: i }); });
  if (!hits.length) { status.textContent = 'No matches for “' + q + '”. Try a shorter word, such as “meridian”.'; return; }
  status.textContent = hits.length + ' match' + (hits.length === 1 ? '' : 'es') + ' for “' + q + '”' + (hits.length > 30 ? ' (showing the first 30)' : '') + '.';
  hits.slice(0, 30).forEach(function (h) {
    var t = h.it.text, s = Math.max(0, h.i - 55), e = Math.min(t.length, h.i + q.length + 90);
    var snip = el('span', null, s > 0 ? '… ' : '', t.slice(s, h.i), el('mark', null, t.slice(h.i, h.i + q.length)), t.slice(h.i + q.length, e), e < t.length ? ' …' : '');
    out.append(el('li', null, el('a', { href: '#' + h.it.id, on: { click: function (ev) { ev.preventDefault(); closeDlg($('#searchDlg')); setTimeout(function () { goTo(h.it.id); }, 30); } } },
      el('span', { class: 'r-sec' }, h.it.secTitle), snip)));
  });
}

/* ---------- bookmarks and library ---------- */
function bookmarks() { return store.get('ug.reader.bookmarks', {}); }
function renderBookmark() {
  $('#bmBtn').setAttribute('aria-pressed', String(C.bookmarked));
  $('#bmBtn').setAttribute('aria-label', C.bookmarked ? 'Remove bookmark for this chapter' : 'Bookmark this chapter');
  var n = Object.keys(bookmarks()).length; $('#libCount').textContent = n || '';
}
function toggleBookmark() {
  C.bookmarked = !C.bookmarked; saveC();
  var b = bookmarks();
  if (C.bookmarked) b[DATA.id] = { title: META.title, meta: META.class + ' · ' + META.subject, href: location.href.split('#')[0], at: Date.now() }; else delete b[DATA.id];
  store.set('ug.reader.bookmarks', b); renderBookmark();
