<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NCERT Reader · UPSC Gurukul</title>
<meta name="description" content="An editorial-quality NCERT reading experience from UPSC Gurukul, with revision tools, practice questions and personal study tools.">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#F7F5EF">
<script>
/* Apply the saved theme before first paint so there is no flash. Light is the default. */
try{if(localStorage.getItem('ug-theme')==='dark'){document.documentElement.setAttribute('data-theme','dark');}}catch(e){}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,400&display=swap">
<style>
/* =========================================================
   1. Design tokens
   ========================================================= */
:root{
  --font-serif:"Source Serif 4","Source Serif Pro",Charter,"Iowan Old Style",Georgia,"Times New Roman",serif;
  --font-sans:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;

  --bg:#F7F5EF; --paper:#FFFEFB; --paper-2:#FBF9F3;
  --ink:#20251F; --ink-2:#333B32; --muted:#5C655A;
  --line:#E2DDCF; --line-2:#CFC8B6;
  --accent:#214C3B; --accent-2:#2D6650; --on-accent:#F7F5EF;
  --sage:#8DA595; --sage-soft:#E5EBE3; --sage-ink:#2F5443;
  --gold:#B08F3E; --gold-ink:#7A5F1F; --gold-soft:#F3ECD6;
  --ok:#2C6A48; --ok-soft:#E1EEE5; --bad:#99392D; --bad-soft:#F7E4E0;
  --z-hot:#EFD7AE; --z-mid:#DDE7D6; --z-cold:#DCE6EB;
  --shadow:0 1px 0 rgba(32,37,31,.04),0 10px 28px -16px rgba(32,37,31,.25);

  --hdr-h:68px; --scale:1; --radius:10px;
}
:root[data-theme="dark"]{
  --bg:#151C19; --paper:#1C2621; --paper-2:#19221E;
  --ink:#F1EDE2; --ink-2:#DAD6CA; --muted:#A6B1A7;
  --line:#2B3831; --line-2:#3B4B42;
  --accent:#9CCDB3; --accent-2:#B7DCC7; --on-accent:#10201A;
  --sage:#7FA08C; --sage-soft:#22302A; --sage-ink:#BBD6C6;
  --gold:#C9A85C; --gold-ink:#DABF7E; --gold-soft:#2C291D;
  --ok:#7CC49B; --ok-soft:#1F3328; --bad:#E69A8C; --bad-soft:#3A2521;
  --z-hot:#4A3B1F; --z-mid:#26392F; --z-cold:#233239;
  --shadow:0 1px 0 rgba(0,0,0,.2),0 10px 28px -16px rgba(0,0,0,.6);
}
html.is-scrolled{--hdr-h:54px}

/* =========================================================
   2. Base
   ========================================================= */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:calc(var(--hdr-h) + 24px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1rem/1.6 var(--font-sans);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;transition:background-color .3s,color .3s}
body.no-scroll{overflow:hidden}
img,svg{max-width:100%}
a{color:var(--accent)}
button{font:inherit;color:inherit;cursor:pointer}
h1,h2,h3,p,ol,ul,dl,dd,figure{margin:0}
ol,ul{padding:0;list-style:none}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
[hidden]{display:none!important}
.skip{position:absolute;left:12px;top:-60px;z-index:100;background:var(--accent);color:var(--on-accent);padding:.6rem 1rem;border-radius:8px;text-decoration:none;transition:top .2s}
.skip:focus{top:12px}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* =========================================================
   3. Animated header
   ========================================================= */
@keyframes hdrIn{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:none}}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes ringDraw{from{stroke-dashoffset:126}to{stroke-dashoffset:0}}
@keyframes sweep{from{background-position:200% 0}to{background-position:-200% 0}}

.hdr{position:sticky;top:0;z-index:50;height:var(--hdr-h);background:var(--bg);
  background:color-mix(in srgb,var(--bg) 90%,transparent);
  -webkit-backdrop-filter:blur(10px) saturate(1.1);backdrop-filter:blur(10px) saturate(1.1);
  border-bottom:1px solid transparent;transition:height .3s ease,border-color .3s,box-shadow .3s;
  animation:hdrIn .7s cubic-bezier(.2,.7,.2,1) both}
html.is-scrolled .hdr{border-bottom-color:var(--line);box-shadow:0 10px 24px -20px rgba(0,0,0,.45)}
.hdr__in{height:100%;max-width:1240px;margin:0 auto;padding:0 clamp(12px,3vw,32px);display:flex;align-items:center;gap:clamp(8px,1.6vw,20px)}
.hdr__in>*{animation:fadeUp .6s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(var(--i,0) * 70ms + 160ms)}
.hdr__bar{position:absolute;left:0;right:0;bottom:-1px;height:2px;background:linear-gradient(90deg,var(--gold),var(--accent));transform:scaleX(0);transform-origin:0 50%;will-change:transform}

.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;color:var(--ink);min-width:0}
.brand__mark{position:relative;flex:none;width:42px;height:42px;border-radius:50%;background:var(--paper);display:grid;place-items:center;transition:width .3s,height .3s}
html.is-scrolled .brand__mark{width:34px;height:34px}
.brand__mark img{width:76%;height:76%;object-fit:contain;border-radius:50%}
.brand__fb{font:600 .95rem/1 var(--font-serif);color:var(--accent);letter-spacing:.02em}
.brand__ring{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
.brand__ring circle{fill:none;stroke:var(--gold);stroke-width:1.6;stroke-dasharray:126;stroke-dashoffset:0;animation:ringDraw 1.4s .35s cubic-bezier(.3,.7,.2,1) both}
.brand__ring .base{stroke:var(--line-2);animation:none;stroke-dasharray:none;stroke-width:1}
.brand__text{display:flex;flex-direction:column;line-height:1.15;min-width:0}
.brand__name{font:600 1.02rem/1.1 var(--font-serif);letter-spacing:.005em;white-space:nowrap}
.brand__series{font:500 .75rem/1.2 var(--font-sans);color:var(--muted);white-space:nowrap;
  background:linear-gradient(90deg,var(--muted) 40%,var(--gold-ink) 50%,var(--muted) 60%) 0 0/200% 100%;
  -webkit-background-clip:text;background-clip:text;color:transparent;animation:sweep 4s 1.6s ease-in-out 1 both}
.crumbs{flex:1;min-width:0;display:none}
.crumbs ol{display:flex;align-items:center;gap:.5rem;font-size:.8125rem;color:var(--muted);white-space:nowrap;overflow:hidden}
.crumbs li{display:flex;align-items:center;gap:.5rem;min-width:0}
.crumbs li+li::before{content:"/";color:var(--line-2)}
.crumbs a{color:var(--muted);text-decoration:none;background:linear-gradient(var(--gold),var(--gold)) 0 100%/0 1px no-repeat;transition:background-size .3s,color .2s}
.crumbs a:hover{color:var(--ink);background-size:100% 1px}
.crumbs [aria-current]{color:var(--ink)}
.crumbs .crumb-sec{color:var(--gold-ink);overflow:hidden;text-overflow:ellipsis;animation:fadeUp .35s both}
.hdr__tools{margin-left:auto;display:flex;align-items:center;gap:4px}

.icon-btn{position:relative;display:inline-grid;place-items:center;width:40px;height:40px;border:1px solid transparent;border-radius:10px;background:none;color:var(--ink);transition:background-color .2s,border-color .2s,color .2s,transform .2s}
.icon-btn:hover{background:var(--sage-soft);border-color:var(--line)}
.icon-btn:active{transform:scale(.94)}
.icon-btn svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.icon-btn[aria-pressed="true"]{color:var(--gold-ink)}
.icon-btn[aria-pressed="true"] svg path{fill:currentColor}
@media (pointer:coarse){.icon-btn{width:44px;height:44px}}
.search-btn{display:none;align-items:center;gap:.55rem;height:40px;padding:0 .75rem 0 .65rem;border:1px solid var(--line-2);border-radius:10px;background:var(--paper);color:var(--muted);font-size:.875rem;transition:border-color .2s,color .2s}
.search-btn:hover{border-color:var(--sage);color:var(--ink)}
.search-btn svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}
.kbd{font:500 .72rem/1 var(--font-sans);border:1px solid var(--line-2);border-bottom-width:2px;border-radius:5px;padding:.18rem .4rem;color:var(--muted)}
.theme-btn .i-moon{display:none}
:root[data-theme="dark"] .theme-btn .i-moon{display:block}
:root[data-theme="dark"] .theme-btn .i-sun{display:none}
.menu-btn{margin-left:-6px}

@media (min-width:720px){.search-btn{display:inline-flex}.icon-btn.search-icon{display:none}}
@media (min-width:1100px){.crumbs{display:block}}
@media (min-width:1024px){.menu-btn{display:none}}
@media (max-width:420px){.brand__series{display:none}.brand__name{font-size:.98rem}}

/* =========================================================
   4. Layout
   ========================================================= */
.shell{max-width:1240px;margin:0 auto;padding:0 clamp(16px,3vw,32px) 5rem;display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(24px,4vw,64px)}
@media (min-width:1024px){.shell{grid-template-columns:264px minmax(0,1fr)}}
.main{min-width:0;outline:none}

/* Sidebar / drawer */
.side{background:var(--bg);font-size:.9rem}
@media (min-width:1024px){
  .side{position:sticky;top:calc(var(--hdr-h) + 18px);align-self:start;max-height:calc(100vh - var(--hdr-h) - 36px);overflow:auto;padding:1.25rem 8px 1.5rem 0;scrollbar-width:thin;transition:top .3s ease}
  .side__close{display:none}
  .scrim{display:none!important}
}
@media (max-width:1023.98px){
  .side{position:fixed;z-index:70;left:0;top:0;bottom:0;width:min(88vw,340px);overflow:auto;padding:1rem 1.1rem 2rem;background:var(--paper);border-right:1px solid var(--line-2);box-shadow:var(--shadow);transform:translateX(-104%);visibility:hidden;transition:transform .32s cubic-bezier(.2,.7,.2,1),visibility 0s .32s}
  .side.is-open{transform:none;visibility:visible;transition:transform .32s cubic-bezier(.2,.7,.2,1),visibility 0s}
  .scrim{position:fixed;inset:0;z-index:65;background:rgba(21,28,25,.45);animation:fadeUp .2s both}
}
.side__top{display:flex;align-items:center;justify-content:space-between;margin-bottom:.4rem}
.side__h{font:600 .8125rem/1.3 var(--font-sans);color:var(--muted);letter-spacing:.01em;margin:0 0 .6rem}
.outline li{position:relative}
.outline a{display:grid;grid-template-columns:1.9rem 1fr auto;align-items:baseline;gap:.2rem;padding:.5rem .6rem .5rem .75rem;border-left:2px solid var(--line);text-decoration:none;color:var(--ink-2);line-height:1.35;transition:background-color .2s,border-color .2s,color .2s}
.outline a:hover{background:var(--sage-soft)}
.outline .n{font:500 .8rem var(--font-serif);color:var(--muted);font-variant-numeric:tabular-nums}
.outline a[aria-current="location"]{border-left-color:var(--gold);color:var(--ink);font-weight:600;background:var(--sage-soft)}
.outline .seen{width:.5rem;height:.5rem;border-radius:50%;background:transparent;border:1px solid var(--line-2)}
.outline .is-seen .seen{background:var(--sage);border-color:var(--sage)}
.panel{margin-top:1.6rem;padding-top:1.1rem;border-top:1px solid var(--line)}
.segs{display:flex;gap:3px;margin-bottom:.8rem}
.segs i{flex:1;height:5px;border-radius:3px;background:var(--line);transition:background-color .3s}
.segs i.on{background:var(--sage)}
.stats{display:grid;gap:.55rem;margin-bottom:.9rem}
.stats div{display:grid;gap:.05rem}
.stats dt{font-size:.78rem;color:var(--muted)}
.stats dd{font-size:.875rem;color:var(--ink)}
.row{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:.35rem 0;font-size:.875rem}
.stepper{display:inline-flex;align-items:center;border:1px solid var(--line-2);border-radius:9px;background:var(--paper);overflow:hidden}
.stepper button{border:0;background:none;width:36px;height:34px;font:600 .85rem var(--font-serif);color:var(--ink);transition:background-color .2s}
.stepper button:hover:not(:disabled){background:var(--sage-soft)}
.stepper button:disabled{opacity:.35;cursor:default}
.stepper output{min-width:3.2rem;text-align:center;font-size:.8rem;color:var(--muted);font-variant-numeric:tabular-nums}
.switch{position:relative;width:42px;height:24px;border-radius:999px;border:1px solid var(--line-2);background:var(--paper);padding:0;transition:background-color .25s,border-color .25s}
.switch__knob{position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:var(--muted);transition:transform .25s,background-color .25s}
.switch[aria-checked="true"]{background:var(--accent);border-color:var(--accent)}
.switch[aria-checked="true"] .switch__knob{transform:translateX(18px);background:var(--on-accent)}
.tool{display:flex;align-items:center;justify-content:space-between;width:100%;padding:.55rem .6rem;border:0;border-radius:8px;background:none;text-align:left;font-size:.875rem;color:var(--ink-2);transition:background-color .2s}
.tool:hover{background:var(--sage-soft);color:var(--ink)}
.pill{font:500 .72rem/1 var(--font-sans);padding:.2rem .45rem;border-radius:999px;background:var(--gold-soft);color:var(--gold-ink)}
.pill:empty{display:none}
.note{margin-top:1rem;padding:.7rem .8rem;border:1px dashed var(--line-2);border-radius:8px;font-size:.8rem;color:var(--muted)}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:42px;padding:.55rem 1.05rem;border:1px solid var(--line-2);border-radius:10px;background:var(--paper);color:var(--ink);font-size:.9rem;font-weight:500;text-decoration:none;transition:background-color .2s,border-color .2s,color .2s,transform .2s}
.btn:hover{border-color:var(--sage);background:var(--sage-soft)}
.btn:active{transform:translateY(1px)}
.btn--primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.btn--primary:hover{background:var(--accent-2);border-color:var(--accent-2);color:var(--on-accent)}
.btn--block{width:100%}
.btn--done{border-color:var(--ok);color:var(--ok);background:var(--ok-soft)}

/* =========================================================
   5. Chapter hero
   ========================================================= */
.hero{position:relative;isolation:isolate;padding:clamp(1.8rem,4.5vw,3.2rem) 0 clamp(1.8rem,4vw,2.6rem);border-bottom:1px solid var(--line)}
.hero__contours{position:absolute;z-index:-1;right:-6%;top:-14%;width:min(640px,78%);height:auto;color:var(--sage);opacity:.5;
  -webkit-mask-image:radial-gradient(closest-side,#000 35%,transparent 100%);mask-image:radial-gradient(closest-side,#000 35%,transparent 100%);animation:drift 80s ease-in-out infinite alternate}
@keyframes drift{from{transform:rotate(-2deg) scale(1)}to{transform:rotate(3deg) scale(1.04)}}
.hero__no{position:absolute;z-index:-1;right:0;top:-.05em;font:300 clamp(7rem,20vw,12.5rem)/1 var(--font-serif);color:transparent;-webkit-text-stroke:1px var(--gold);opacity:.5;user-select:none;font-variant-numeric:lining-nums}
.hero>*:not(.hero__contours):not(.hero__no){animation:fadeUp .8s cubic-bezier(.2,.7,.2,1) both}
.hero__kicker{animation-delay:.1s!important;font:500 .9rem/1.3 var(--font-sans);color:var(--gold-ink);display:flex;align-items:center;gap:.75rem}
.hero__kicker::before{content:"";width:2.2rem;height:1px;background:var(--gold)}
.hero h1{animation-delay:.2s!important;margin:.55em 0 .5em;max-width:17em;font:600 clamp(2rem,1.15rem + 3.7vw,3.5rem)/1.08 var(--font-serif);letter-spacing:-.012em;text-wrap:balance;overflow-wrap:anywhere}
.hero__lede{animation-delay:.3s!important;max-width:40rem;font:400 clamp(1.05rem,1rem + .35vw,1.25rem)/1.6 var(--font-serif);color:var(--ink-2)}
.hero__meta{animation-delay:.4s!important;display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;margin-top:1.4rem;font-size:.875rem;color:var(--muted)}
.hero__meta li{display:flex;align-items:center;gap:.4rem}
.hero__meta strong{color:var(--ink);font-weight:600}
.chip{display:inline-flex;align-items:center;gap:.45rem;padding:.2rem .65rem;border:1px solid var(--line-2);border-radius:999px;background:var(--paper);font-size:.8rem;color:var(--ink-2)}
.chip::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:var(--line-2)}
.chip[data-state="progress"]::before{background:var(--gold)}
.chip[data-state="done"]{border-color:var(--ok);color:var(--ok)}
.chip[data-state="done"]::before{background:var(--ok)}
.hero__cols{animation-delay:.5s!important;display:grid;gap:2rem;margin-top:2.2rem}
@media (min-width:900px){.hero__cols{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:3rem}}
.hero h2{font:600 .95rem/1.3 var(--font-sans);margin-bottom:.9rem;color:var(--ink)}
.objectives ol{counter-reset:o;display:grid;gap:.75rem}
.objectives li{counter-increment:o;display:grid;grid-template-columns:2.2rem 1fr;align-items:baseline;font:400 1.02rem/1.5 var(--font-serif);color:var(--ink-2)}
.objectives li::before{content:counter(o,decimal-leading-zero);font:300 1.4rem/1 var(--font-serif);color:var(--gold-ink);font-variant-numeric:tabular-nums}
.legend{padding:1rem 1.1rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-2);align-self:start}
.legend ul{display:grid;gap:.55rem;font-size:.84rem;color:var(--muted);line-height:1.45}
.legend b{color:var(--ink);font-weight:600}
.hero__actions{animation-delay:.6s!important;display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}
.demo-note{animation-delay:.7s!important;margin-top:1.6rem;max-width:44rem;padding:.8rem 1rem;border:1px dashed var(--gold);border-radius:var(--radius);background:var(--gold-soft);font-size:.85rem;line-height:1.5;color:var(--ink-2)}
.quick-note{margin-top:1.5rem;padding:.7rem 1rem;border-left:3px solid var(--accent);background:var(--sage-soft);font-size:.875rem;color:var(--ink-2);border-radius:0 8px 8px 0}

/* =========================================================
   6. Reading column
   ========================================================= */
.sec{padding-top:clamp(2.4rem,5vw,3.6rem)}
.sec+.sec{margin-top:clamp(2rem,4vw,3rem);border-top:1px solid var(--line)}
.sec>*{max-width:46rem}
.sec__head{display:flex;flex-direction:column;gap:.35rem;margin-bottom:1.4rem}
.sec__no{display:flex;align-items:center;gap:.8rem;font:300 1.5rem/1 var(--font-serif);color:var(--gold-ink);font-variant-numeric:tabular-nums}
.sec__no::after{content:"";height:1px;width:3rem;background:var(--gold);opacity:.6}
.sec h2{font:600 clamp(1.55rem,1.2rem + 1.4vw,2.15rem)/1.18 var(--font-serif);letter-spacing:-.008em;text-wrap:balance}
.blk{margin-top:1.15rem}
.blk--p,.blk--list{font:400 calc(1.125rem * var(--scale))/1.74 var(--font-serif);color:var(--ink);hyphens:auto;-webkit-hyphens:auto}
.blk--p+.blk--p{margin-top:1.1em}
.sec__head+.blk--p{margin-top:0}
#sec-grid .sec__head+.blk--p::first-letter{float:left;font:600 3.7em/.82 var(--font-serif);padding:.06em .1em 0 0;color:var(--accent)}
.blk--list{padding-left:1.4rem}
.blk--list ul,ul.blk--list{list-style:disc}
ol.blk--list{list-style:decimal}
.blk--list li{padding-left:.3rem;margin-top:.45em}
.blk--list li::marker{color:var(--gold-ink)}
.blk--h3{font:600 calc(1.25rem * var(--scale))/1.3 var(--font-serif);margin-top:2rem}

.term{padding:0;border:0;background:none;font:inherit;color:inherit;cursor:help;border-bottom:1.5px dotted var(--gold);transition:background-color .2s,color .2s}
.term:hover,.term[aria-expanded="true"]{background:var(--gold-soft);color:var(--ink)}
.term-pop{position:fixed;z-index:80;max-width:min(300px,calc(100vw - 24px));padding:.75rem .9rem;border:1px solid var(--line-2);border-radius:10px;background:var(--paper);box-shadow:var(--shadow);font:400 .85rem/1.5 var(--font-sans);color:var(--ink-2);display:grid;gap:.2rem}
.term-pop strong{color:var(--ink)}
mark.hl{background:color-mix(in srgb,var(--gold) 35%,transparent);color:inherit;border-radius:2px;padding:0 1px;cursor:pointer}
.flash-hit{animation:flash 1.8s ease-out}
@keyframes flash{0%,40%{box-shadow:0 0 0 6px color-mix(in srgb,var(--gold) 38%,transparent);background:color-mix(in srgb,var(--gold) 14%,transparent)}100%{box-shadow:0 0 0 6px transparent;background:transparent}}

/* Definition */
.blk--def{position:relative;padding:1.1rem 1.3rem 1.2rem 1.5rem;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:0 var(--radius) var(--radius) 0;background:var(--paper)}
.def__label{display:block;font:500 .78rem/1 var(--font-sans);color:var(--gold-ink);margin-bottom:.5rem}
.def__term{display:block;font:italic 600 calc(1.3rem * var(--scale))/1.25 var(--font-serif);color:var(--accent);margin-bottom:.3rem}
.def__text{font:400 calc(1.05rem * var(--scale))/1.62 var(--font-serif);color:var(--ink-2)}

/* Callouts */
.callout{padding:1rem 1.2rem 1.15rem;border-radius:var(--radius);border:1px solid var(--line);background:var(--paper-2)}
.callout__label{display:flex;align-items:center;gap:.5rem;font:600 .8rem/1 var(--font-sans);margin-bottom:.55rem}
.callout__label::before{content:"";width:.55rem;height:.55rem;border-radius:2px;background:currentColor;transform:rotate(45deg)}
.callout__title{font:600 calc(1.05rem * var(--scale))/1.35 var(--font-serif);margin-bottom:.25rem;color:var(--ink)}
.callout__text{font:400 calc(1.02rem * var(--scale))/1.65 var(--font-serif);color:var(--ink-2)}
.callout--concept{background:var(--sage-soft);border-color:transparent}.callout--concept .callout__label{color:var(--sage-ink)}
.callout--upsc{background:var(--gold-soft);border-color:transparent}.callout--upsc .callout__label{color:var(--gold-ink)}
.callout--enrich{background:var(--paper);border-style:dashed;border-color:var(--line-2)}.callout--enrich .callout__label{color:var(--muted)}
.callout--caution{background:var(--bad-soft);border-color:transparent}.callout--caution .callout__label{color:var(--bad)}
.callout--ncert{background:var(--paper);border-color:var(--accent)}.callout--ncert .callout__label{color:var(--accent)}

/* Tables */
.blk--table figcaption{font:600 .9rem/1.3 var(--font-sans);margin-bottom:.6rem;color:var(--ink)}
.table-wrap{overflow-x:auto;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper)}
.table-wrap table{width:100%;min-width:34rem;border-collapse:collapse;font-size:.92rem;line-height:1.5}
.table-wrap th,.table-wrap td{padding:.7rem .9rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
.table-wrap thead th{background:var(--sage-soft);font-weight:600;color:var(--ink);white-space:nowrap}
.table-wrap tbody th{font-weight:600;color:var(--accent);white-space:nowrap}
.table-wrap tbody tr:last-child>*{border-bottom:0}
.table-wrap tbody tr:hover>*{background:var(--paper-2)}

/* Worked example */
.blk--example{position:relative;padding:1.2rem 1.3rem;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper)}
.ex__label{font:500 .78rem/1 var(--font-sans);color:var(--accent);margin-bottom:.55rem;display:block}
.ex__title{font:600 calc(1.15rem * var(--scale))/1.3 var(--font-serif);margin-bottom:.8rem}
.ex__steps{counter-reset:s;display:grid;gap:.6rem}
.ex__steps li{counter-increment:s;display:grid;grid-template-columns:1.8rem 1fr;font:400 calc(1.02rem * var(--scale))/1.55 var(--font-serif);color:var(--ink-2)}
.ex__steps li::before{content:counter(s);display:grid;place-items:center;width:1.35rem;height:1.35rem;margin-top:.2rem;border-radius:50%;border:1px solid var(--sage);font:600 .72rem var(--font-sans);color:var(--sage-ink)}
.ex__answer{margin-top:1rem;padding-top:.85rem;border-top:1px dashed var(--line-2);font:600 calc(1.05rem * var(--scale))/1.5 var(--font-serif);color:var(--accent)}

/* Diagram */
.blk--diagram{max-width:none}
.blk--diagram .fig{padding:1rem;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper);display:grid;place-items:center}
.blk--diagram svg{width:100%;height:auto;max-width:520px;display:block}
.blk--diagram figcaption{margin-top:.7rem;font:400 .875rem/1.5 var(--font-sans);color:var(--muted)}
.blk--diagram figcaption b{color:var(--ink);font-weight:600}
.tag-static{display:inline-block;margin-left:.4rem;padding:.05rem .45rem;border:1px solid var(--line-2);border-radius:999px;font-size:.72rem;color:var(--muted)}
.dg text{fill:var(--ink-2);font:500 15px var(--font-sans)}
.dg .dg-globe{fill:var(--paper-2);stroke:var(--ink-2);stroke-width:1.4}
.dg .dg-line{fill:none;stroke:var(--sage);stroke-width:1.1}
.dg .dg-eq{fill:none;stroke:var(--gold);stroke-width:2.4}
.dg .dg-pm{fill:none;stroke:var(--accent);stroke-width:2.2}
.dg .dg-tick{stroke:var(--line-2);stroke-width:1}
.dg .dg-hl{font-weight:600;fill:var(--ink)}
.dg .z-hot{fill:var(--z-hot)}.dg .z-mid{fill:var(--z-mid)}.dg .z-cold{fill:var(--z-cold)}
.dg .dg-dash{stroke:var(--ink-2);stroke-width:1.2;stroke-dasharray:5 4;fill:none}
.dg .dg-zlabel{font:600 15px var(--font-serif);fill:var(--ink)}

/* Cause-and-effect sequence */
.blk--seq{padding:1.2rem 1.3rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-2)}
.seq__title{font:600 .9rem/1.3 var(--font-sans);margin-bottom:1rem}
.seq{display:grid;gap:0;counter-reset:q}
.seq li{counter-increment:q;position:relative;padding:0 0 1.15rem 2.6rem}
.seq li:last-child{padding-bottom:0}
.seq li::before{content:counter(q);position:absolute;left:0;top:0;display:grid;place-items:center;width:1.8rem;height:1.8rem;border-radius:50%;background:var(--accent);color:var(--on-accent);font:600 .8rem var(--font-sans)}
.seq li:not(:last-child)::after{content:"";position:absolute;left:.88rem;top:1.9rem;bottom:.1rem;width:1px;background:var(--line-2)}
.seq b{display:block;font:600 calc(1.02rem * var(--scale))/1.35 var(--font-serif)}
.seq span{display:block;font:400 calc(.98rem * var(--scale))/1.55 var(--font-serif);color:var(--ink-2)}
@media (min-width:720px){
  .blk--seq{max-width:none}
  .seq{grid-template-columns:repeat(var(--n,4),1fr);gap:1rem}
  .seq li{padding:2.6rem 0 0 0}
  .seq li:not(:last-child)::after{left:2rem;right:-1rem;top:.88rem;bottom:auto;width:auto;height:1px}
}

/* Pull quote */
.blk--quote{padding:.4rem 0 .4rem 1.5rem;border-left:2px solid var(--gold)}
.quote__label{display:block;font:500 .78rem/1 var(--font-sans);color:var(--gold-ink);margin-bottom:.6rem}
.blk--quote p{font:italic 400 calc(1.5rem * var(--scale))/1.4 var(--font-serif);color:var(--accent);text-wrap:balance}

/* Expandable */
.blk--expand,.recall{border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper)}
.blk--expand summary,.recall summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.9rem 1.1rem;cursor:pointer;font:600 .95rem/1.4 var(--font-sans);color:var(--ink)}
.blk--expand summary::-webkit-details-marker,.recall summary::-webkit-details-marker{display:none}
.blk--expand summary::after,.recall summary::after{content:"";flex:none;width:.55rem;height:.55rem;border-right:1.7px solid var(--muted);border-bottom:1.7px solid var(--muted);transform:rotate(45deg);transition:transform .25s}
.blk--expand[open] summary::after,.recall[open] summary::after{transform:rotate(-135deg)}
.blk--expand summary:hover,.recall summary:hover{background:var(--paper-2);border-radius:var(--radius)}
.expand__body{padding:0 1.1rem 1.1rem}
.expand__body .blk{margin-top:.6rem}

/* =========================================================
   7. Revision
   ========================================================= */
.sec--revise{margin-top:clamp(2.5rem,5vw,4rem)!important;padding:clamp(2rem,4vw,3rem) clamp(1.1rem,3vw,2.2rem);border:1px solid var(--line-2)!important;border-radius:16px;background:linear-gradient(180deg,var(--paper) 0,var(--paper-2) 100%)}
.sec--revise>*{max-width:none}
.sec--revise .rev{margin-top:2.2rem;max-width:46rem}
.sec--revise .rev--wide{max-width:none}
.rev>h3{font:600 1.15rem/1.3 var(--font-serif);margin-bottom:.9rem;display:flex;align-items:center;gap:.7rem}
.rev>h3::after{content:"";flex:1;height:1px;background:var(--line)}
.rev-bar{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem 1.4rem;justify-content:space-between;padding:.7rem 1rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);font-size:.88rem;color:var(--ink-2);max-width:46rem}
.takeaways{counter-reset:t;display:grid;gap:.8rem}
.takeaways li{counter-increment:t;display:grid;grid-template-columns:2.2rem 1fr;align-items:baseline;font:400 1.05rem/1.55 var(--font-serif)}
.takeaways li::before{content:counter(t,decimal-leading-zero);font:300 1.3rem/1 var(--font-serif);color:var(--gold-ink)}
.defs{display:grid;gap:.4rem;border-top:1px solid var(--line)}
.defs div{display:grid;gap:.15rem;padding:.7rem 0;border-bottom:1px solid var(--line)}
@media (min-width:640px){.defs div{grid-template-columns:11rem 1fr;gap:1rem}}
.defs dt{font:italic 600 1.02rem/1.4 var(--font-serif);color:var(--accent)}
.defs dd{font:400 .98rem/1.55 var(--font-serif);color:var(--ink-2)}
.sheet{padding:1.4rem 1.6rem;border:1px solid var(--ink-2);border-radius:4px;background:var(--paper);box-shadow:6px 6px 0 -1px var(--sage-soft),6px 6px 0 0 var(--line-2)}
.sheet h4{font:600 1rem/1.3 var(--font-serif);padding-bottom:.6rem;margin-bottom:.7rem;border-bottom:2px solid var(--gold)}
.sheet ul{display:grid;gap:.5rem;font:400 1rem/1.55 var(--font-serif);list-style:square;padding-left:1.2rem}
.sheet li::marker{color:var(--gold-ink)}
.flash-grid{display:grid;gap:.8rem;grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
.flash{border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper);overflow:hidden;transition:border-color .2s,box-shadow .2s}
.flash:hover{border-color:var(--sage)}
.flash__q{display:flex;flex-direction:column;align-items:flex-start;gap:.5rem;width:100%;min-height:110px;padding:1rem 1.1rem;border:0;background:none;text-align:left;font:600 1.02rem/1.4 var(--font-serif)}
.flash__q small{font:500 .75rem var(--font-sans);color:var(--muted);margin-top:auto}
.flash__a{padding:.9rem 1.1rem 1.1rem;border-top:1px dashed var(--line-2);background:var(--sage-soft);font:400 .97rem/1.55 var(--font-serif);color:var(--ink-2)}
.flash.is-open{border-color:var(--sage)}
.recall{margin-top:.6rem}
.recall .expand__body{font:400 1rem/1.6 var(--font-serif);color:var(--ink-2)}
.recall .expand__body strong{display:block;font:500 .78rem var(--font-sans);color:var(--accent);margin-bottom:.3rem}
.myths{display:grid;gap:.8rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))}
.myth{padding:1.1rem 1.2rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);font:400 .98rem/1.55 var(--font-serif)}
.myth b{display:block;font:600 .75rem var(--font-sans);margin-bottom:.25rem}
.myth .m{color:var(--bad);margin-bottom:.9rem}
.myth .m p{text-decoration:line-through;text-decoration-color:color-mix(in srgb,var(--bad) 45%,transparent);color:var(--ink-2)}
.myth .f{color:var(--ok)}
.myth .f p{color:var(--ink)}

/* =========================================================
   8. Practice
   ========================================================= */
.sec--practice>*{max-width:46rem}
.sample-flag{display:inline-flex;margin-top:.9rem;padding:.4rem .75rem;border:1px dashed var(--gold);border-radius:8px;background:var(--gold-soft);font-size:.82rem;color:var(--ink-2)}
.q{margin-top:1.1rem;padding:1.2rem 1.3rem;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper);transition:border-color .25s}
.q.is-right{border-color:var(--ok)}.q.is-wrong{border-color:var(--bad)}
.q__no{font:500 .78rem var(--font-sans);color:var(--muted);margin-bottom:.4rem}
.q__text{font:600 calc(1.12rem * var(--scale))/1.45 var(--font-serif);margin-bottom:.9rem}
.opts{display:grid;gap:.5rem}
.opt{display:grid;grid-template-columns:1.9rem 1fr;gap:.5rem;align-items:center;width:100%;min-height:46px;padding:.55rem .8rem;border:1px solid var(--line-2);border-radius:9px;background:var(--bg);text-align:left;font:400 .97rem/1.4 var(--font-sans);transition:border-color .2s,background-color .2s,transform .15s}
.opt:hover:not([aria-disabled="true"]){border-color:var(--accent);background:var(--sage-soft)}
.opt:active:not([aria-disabled="true"]){transform:scale(.995)}
.opt i{display:grid;place-items:center;width:1.6rem;height:1.6rem;border-radius:50%;border:1px solid var(--line-2);font:600 .75rem var(--font-sans);font-style:normal;color:var(--muted)}
.opt[aria-disabled="true"]{cursor:default}
.opt.is-correct{border-color:var(--ok);background:var(--ok-soft)}
.opt.is-correct i{background:var(--ok);border-color:var(--ok);color:var(--on-accent)}
.opt.is-wrong{border-color:var(--bad);background:var(--bad-soft)}
.opt.is-wrong i{background:var(--bad);border-color:var(--bad);color:#fff}
.fb{margin-top:.9rem;font:400 .95rem/1.55 var(--font-sans);color:var(--ink-2)}
.fb strong{display:block;margin-bottom:.15rem}
.fb .good{color:var(--ok)}.fb .bad{color:var(--bad)}
.fb a{font-weight:500}
.quiz-sum{margin-top:1.4rem;padding:1.4rem 1.5rem;border:1px solid var(--accent);border-radius:var(--radius);background:var(--paper)}
.quiz-sum .score{font:300 3rem/1 var(--font-serif);color:var(--accent);font-variant-numeric:tabular-nums}
.quiz-sum .score small{font-size:1.2rem;color:var(--muted)}
.quiz-sum p{margin-top:.6rem;font-size:.92rem;color:var(--ink-2);max-width:34rem}
.quiz-actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.1rem}
.quiz.review .q.is-right,.quiz.review .q.is-open{display:none}
.quiz-empty{margin-top:1.1rem;padding:1.4rem;border:1px dashed var(--line-2);border-radius:var(--radius);color:var(--muted);font-size:.92rem;text-align:center}

/* Footer area */
.after{margin-top:clamp(2.5rem,5vw,3.5rem);display:grid;gap:2rem;max-width:46rem}
.finish{padding:1.5rem 1.6rem;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper);display:grid;gap:.9rem;justify-items:start}
.finish h2{font:600 1.35rem/1.25 var(--font-serif)}
.finish p{font-size:.95rem;color:var(--ink-2);max-width:34rem}
.sources h2{font:600 1.05rem/1.3 var(--font-serif);margin-bottom:.8rem}
.sources ol{display:grid;gap:.8rem;counter-reset:r}
.sources li{counter-increment:r;display:grid;grid-template-columns:1.8rem 1fr;font-size:.9rem;line-height:1.5;color:var(--ink-2)}
.sources li::before{content:"[" counter(r) "]";color:var(--gold-ink);font-variant-numeric:tabular-nums}
.sources small{display:block;color:var(--muted)}
.pn-wrap{display:grid;gap:.9rem;grid-template-columns:1fr}
@media (min-width:640px){.pn-wrap{grid-template-columns:1fr 1fr}}
.pn{display:grid;gap:.25rem;padding:1.05rem 1.2rem;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--paper);text-decoration:none;color:var(--ink);transition:border-color .2s,transform .2s}
a.pn:hover{border-color:var(--accent);transform:translateY(-2px)}
.pn--next{text-align:right}
.pn__dir{font-size:.78rem;color:var(--muted)}
.pn__title{font:600 1.02rem/1.35 var(--font-serif)}
.pn.is-off{border-style:dashed;background:transparent}
.pn.is-off .pn__title{color:var(--muted);font-weight:400;font-size:.92rem}
.print-notes{display:none}

/* =========================================================
   9. Dialogs, toast, floating controls
   ========================================================= */
.dlg{padding:0;border:1px solid var(--line-2);border-radius:14px;background:var(--paper);color:var(--ink);width:min(640px,calc(100vw - 24px));max-height:calc(100dvh - 16vh);box-shadow:0 40px 90px -30px rgba(0,0,0,.55)}
.dlg::backdrop{background:rgba(21,28,25,.5)}
.dlg[open]{animation:fadeUp .25s cubic-bezier(.2,.7,.2,1) both}
.dlg--search{margin:8vh auto auto}
.dlg--sheet{margin:0 0 0 auto;height:100dvh;max-height:none;width:min(440px,100vw);border-radius:0;border-width:0 0 0 1px}
.dlg__in{display:flex;flex-direction:column;height:100%;max-height:inherit}
.dlg__bar{display:flex;align-items:center;gap:.6rem;padding:.7rem .8rem .7rem 1.1rem;border-bottom:1px solid var(--line)}
.dlg__bar svg{width:19px;height:19px;flex:none;fill:none;stroke:var(--muted);stroke-width:1.7;stroke-linecap:round}
.dlg__bar input{flex:1;min-width:0;border:0;background:none;color:var(--ink);font:400 1.05rem var(--font-sans);padding:.5rem 0;outline:none}
.dlg__bar h2{flex:1;font:600 1.1rem var(--font-serif)}
.dlg__status{padding:.65rem 1.1rem;font-size:.82rem;color:var(--muted)}
.dlg__body{overflow:auto;padding:0 1.1rem 1.2rem;flex:1}
.results{overflow:auto;padding:0 .6rem .8rem}
.results a{display:grid;gap:.15rem;padding:.7rem .75rem;border-radius:9px;text-decoration:none;color:var(--ink-2);font-size:.92rem;line-height:1.5}
.results a:hover,.results a:focus-visible{background:var(--sage-soft)}
.results .r-sec{font-size:.75rem;color:var(--gold-ink);font-weight:500}
.results mark{background:color-mix(in srgb,var(--gold) 40%,transparent);color:inherit;border-radius:2px}
.notes-area{width:100%;min-height:180px;resize:vertical;padding:.8rem .9rem;border:1px solid var(--line-2);border-radius:var(--radius);background:var(--bg);color:var(--ink);font:400 .98rem/1.6 var(--font-serif)}
.dlg label.lbl{display:block;font:600 .85rem var(--font-sans);margin:1rem 0 .5rem}
.saved-state{margin-top:.4rem;font-size:.78rem;color:var(--muted)}
.hl-list{display:grid;gap:.5rem}
.hl-list li{display:grid;gap:.4rem;padding:.7rem .8rem;border:1px solid var(--line);border-radius:9px;background:var(--paper-2);font:400 .92rem/1.5 var(--font-serif)}
.hl-list .acts{display:flex;gap:.8rem}
.link-btn{border:0;background:none;padding:0;color:var(--accent);font:500 .8rem var(--font-sans);text-decoration:underline;text-underline-offset:3px}
.empty{padding:1.2rem;border:1px dashed var(--line-2);border-radius:var(--radius);font-size:.88rem;line-height:1.55;color:var(--muted)}
.lib-list{display:grid;gap:.6rem}
.lib-list li{display:flex;align-items:center;justify-content:space-between;gap:.8rem;padding:.8rem .9rem;border:1px solid var(--line);border-radius:9px;background:var(--paper-2)}
.lib-list a{font:600 .98rem/1.35 var(--font-serif);color:var(--ink);text-decoration:none}
.lib-list small{display:block;font:400 .78rem var(--font-sans);color:var(--muted)}

.hlbtn{position:fixed;z-index:75;padding:.45rem .8rem;border:0;border-radius:8px;background:var(--ink);color:var(--bg);font:500 .82rem var(--font-sans);box-shadow:var(--shadow);animation:fadeUp .15s both}
.toast{position:fixed;z-index:90;left:50%;bottom:20px;transform:translateX(-50%);max-width:calc(100vw - 32px);padding:.65rem 1rem;border-radius:10px;background:var(--ink);color:var(--bg);font-size:.88rem;box-shadow:var(--shadow);animation:fadeUp .25s both}
.resume{position:fixed;z-index:60;left:50%;bottom:20px;transform:translateX(-50%);display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1rem;max-width:calc(100vw - 24px);padding:.7rem .8rem .7rem 1.1rem;border:1px solid var(--line-2);border-radius:12px;background:var(--paper);box-shadow:var(--shadow);font-size:.88rem;animation:fadeUp .4s .6s both}
.resume .btn{min-height:36px;padding:.3rem .8rem;font-size:.84rem}

/* =========================================================
   10. Motion preferences and print
   ========================================================= */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-delay:0s!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
}
body.quick .blk--p,body.quick .blk--list,body.quick .blk--expand,body.quick .blk--h3{display:none}

@media print{
  :root{--bg:#fff;--paper:#fff;--paper-2:#fff;--ink:#000;--ink-2:#111;--muted:#333;--line:#bbb;--line-2:#999;--sage-soft:#f1f1f1;--gold-soft:#f5f5f5;--bad-soft:#f5f5f5;--ok-soft:#f5f5f5}
  .hdr,.side,.scrim,.hero__contours,.hero__no,.hero__actions,.hlbtn,.toast,.resume,.term-pop,dialog,.quiz-actions,.finish,.rev-bar,.quick-note{display:none!important}
  body{font-size:11pt;background:#fff}
  .shell{display:block;padding:0;max-width:none}
  a{color:#000;text-decoration:none}
  .hero>*{animation:none!important}
  .sec--revise{border:0!important;background:none;padding:0}
  .sec{break-before:auto}
  .blk--def,.callout,.blk--table,.blk--example,.blk--diagram,.q,.flash,.myth,.blk--seq{break-inside:avoid}
  .flash__a[hidden]{display:block!important}
  mark.hl{background:#ddd;color:#000}
  .print-notes{display:block;margin-top:2rem;padding-top:1rem;border-top:1px solid #000;white-space:pre-wrap}
  .print-notes:empty{display:none}
  .opt{border:1px solid #999}
  body.quick .blk--p,body.quick .blk--list,body.quick .blk--expand,body.quick .blk--h3{display:block}
}
</style>
