    var m = e.target.closest ? e.target.closest('mark.hl') : null;
    if (m && !window.getSelection().toString()) { var r = m.getBoundingClientRect(), id = m.dataset.hid; showHl('remove', r, 'Remove highlight'); hlPending = { remove: id }; return; }
