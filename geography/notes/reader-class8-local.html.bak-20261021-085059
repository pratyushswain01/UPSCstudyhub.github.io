  var ul = $('#libList'); ul.replaceChildren();
  var b = bookmarks(), keys = Object.keys(b);
  if (!keys.length) { ul.append(el('li', { class: 'empty' }, 'No saved chapters yet. Use the bookmark button in the header to save a chapter you want to come back to.')); return; }
  keys.forEach(function (k) {
    ul.append(el('li', null, el('div', null, el('a', { href: b[k].href }, b[k].title), el('small', null, b[k].meta)),
      el('button', { class: 'link-btn', type: 'button', on: { click: function () { var all = bookmarks(); delete all[k]; store.set('ug.reader.bookmarks', all); if (k === DATA.id) { C.bookmarked = false; saveC(); } renderBookmark(); renderLib(); } } }, 'Remove')));
  });
}

/* ---------- scroll: header, progress line, active section, position ---------- */
var secEls = [], activeId = null, ticking = false;
var savePos = debounce(function () { if (activeId) { C.pos = { sec: activeId, y: Math.round(window.scrollY) }; saveC(); } }, 500);
function setActive(id) {
  activeId = id;
  $$('#outline a').forEach(function (a) { if (a.getAttribute('href') === '#' + id) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
  var crumb = $('#crumbSec'), o = OUT.filter(function (x) { return x.id === id; })[0];
  if (o) { crumb.textContent = o.title; crumb.hidden = false; crumb.style.animation = 'none'; void crumb.offsetWidth; crumb.style.animation = ''; } else { crumb.hidden = true; }
  if (id && C.visited.indexOf(id) === -1) { C.visited.push(id); saveC(); renderProgress(); }
}
function update() {
  ticking = false;
  var y = window.scrollY;
  root.classList.toggle('is-scrolled', y > 24);
  var art = $('#chapter').getBoundingClientRect(), total = art.height - window.innerHeight;
  var f = total > 0 ? Math.min(1, Math.max(0, -art.top / total)) : 0;
  $('#readBar').style.transform = 'scaleX(' + f.toFixed(4) + ')';
  var cur = null;
  secEls.forEach(function (s) { if (s.getBoundingClientRect().top <= 140) cur = s.id; });
  if (window.innerHeight + y >= document.documentElement.scrollHeight - 4 && secEls.length) cur = secEls[secEls.length - 1].id;
  if (cur !== activeId) setActive(cur);
