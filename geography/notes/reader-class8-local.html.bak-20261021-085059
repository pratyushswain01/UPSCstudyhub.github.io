  if (closed) side.setAttribute('aria-hidden', 'true'); else side.removeAttribute('aria-hidden');
  try { $('#main').inert = !mqDesk.matches && side.classList.contains('is-open'); } catch (e) {}
}
function setDrawer(open, silent) {
  side.classList.toggle('is-open', open); scrim.hidden = !open;
  menuBtn.setAttribute('aria-expanded', String(open));
  document.body.classList.toggle('no-scroll', open);
  syncInert();
  if (open) { var a = $('a', side); if (a) a.focus(); } else if (!silent) { menuBtn.focus(); }
}

/* ---------- key-term popover ---------- */
var pop = $('#termPop'), popBtn = null;
function closeTerm() { if (popBtn) { popBtn.setAttribute('aria-expanded', 'false'); popBtn.removeAttribute('aria-describedby'); } popBtn = null; pop.hidden = true; }
function openTerm(btn) {
