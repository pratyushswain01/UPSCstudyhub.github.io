  closeTerm(); popBtn = btn;
  pop.replaceChildren(el('strong', null, btn.textContent), el('span', null, btn.dataset.def));
  pop.hidden = false; btn.setAttribute('aria-expanded', 'true'); btn.setAttribute('aria-describedby', 'termPop');
  var r = btn.getBoundingClientRect(), w = pop.offsetWidth, h = pop.offsetHeight;
  var left = Math.max(12, Math.min(r.left, window.innerWidth - w - 12));
  var top = r.bottom + 8; if (top + h > window.innerHeight - 8) top = Math.max(8, r.top - h - 8);
  pop.style.left = left + 'px'; pop.style.top = top + 'px';
}

/* ---------- highlights ---------- */
var hlBtn = $('#hlBtn'), hlMode = null, hlPending = null;
