  var pre = document.createRange(); pre.selectNodeContents(host); pre.setEnd(r.startContainer, r.startOffset);
  var s = pre.toString().length, txt = r.toString(), e = s + txt.length, hid = 'h' + Date.now().toString(36) + Math.floor(Math.random() * 1000);
  wrapRange(host, s, e, hid);
  C.highlights.push({ id: hid, el: host.dataset.hl, s: s, e: e, text: txt.replace(/\s+/g, ' ').trim().slice(0, 140) });
