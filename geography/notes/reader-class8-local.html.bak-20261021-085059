<header class="hdr" id="hdr">
  <div class="hdr__in">
    <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-label="Open chapter outline" aria-expanded="false" aria-controls="side" style="--i:0">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
    </button>
