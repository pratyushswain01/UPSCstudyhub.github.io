    var tag = (e.target.tagName || '').toLowerCase();
    var typing = tag === 'input' || tag === 'textarea' || e.target.isContentEditable;
    if ((e.key === '/' && !typing && !e.ctrlKey && !e.metaKey) || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) { e.preventDefault(); openSearch(); }
  });
  window.addEventListener('scroll', function () { onScroll(); closeTerm(); }, { passive: true });
  window.addEventListener('resize', onScroll);

  var closed = [];
  window.addEventListener('beforeprint', function () {
    closed = $$('details').filter(function (d) { return !d.open; }); closed.forEach(function (d) { d.open = true; });
    $('#printNotes').textContent = C.notes.trim() ? 'My notes\n\n' + C.notes : '';
  });
  window.addEventListener('afterprint', function () { closed.forEach(function (d) { d.open = false; }); closed = []; $('#printNotes').textContent = ''; });
}

/* ---------- logo ---------- */
