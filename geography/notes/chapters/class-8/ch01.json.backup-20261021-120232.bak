{
  "pdf": { "href": "pdfs/hess401.pdf", "title": "NCERT Class 8, Chapter 1" },
  "schemaVersion": 1,
  "id": "class-8-geography-ch01",
  "demo": false,
  "meta": {
    "class": "8",
    "subject": "Geography",
    "chapterNo": 1,
    "title": "Resources",
    "intro": "Understand resources, their types, and how people use and conserve them.",
    "subjectHref": "../index.html",
    "prev": null,
    "next": null
  },
  "objectives": [
    "Explain what a resource is.",
    "Identify natural, human-made and human resources.",
    "Distinguish renewable and non-renewable resources.",
    "Understand resource conservation and sustainable development."
  ],
  "sections": [
    {
      "id": "meaning",
      "title": "Meaning of Resources",
      "blocks": [
        {
          "type": "p",
          "text": "Anything that can be used to satisfy a human need may be considered a resource when it is accessible, usable and culturally acceptable."
        },
        {
          "type": "def",
          "term": "Utility",
          "text": "The capacity of something to satisfy a human need."
        },
        {
          "type": "def",
          "term": "Value",
          "text": "The worth of a resource. It may be economic or non-economic and can change over time."
        },
        {
          "type": "example",
          "title": "Example",
          "text": "Sunlight provides light and energy. Knowledge and skills also help people create and use resources."
        }
      ]
    },
    {
      "id": "types",
      "title": "Types of Resources",
      "blocks": [
        {
          "type": "h3",
          "text": "Natural resources"
        },
        {
          "type": "p",
          "text": "Resources obtained from nature and used with varying degrees of modification."
        },
        {
          "type": "list",
          "items": [
            "Examples: air, water, soil, forests and minerals.",
            "Some natural resources can be replenished; others are limited."
          ]
        },
        {
          "type": "h3",
          "text": "Human-made resources"
        },
        {
          "type": "p",
          "text": "Resources created when people transform natural materials into useful things."
        },
        {
          "type": "example",
          "title": "Examples",
          "text": "Buildings, roads, machines and bridges."
        },
        {
          "type": "h3",
          "text": "Human resources"
        },
        {
          "type": "p",
          "text": "People and their knowledge, skills, health and abilities that help develop and use resources."
        }
      ]
    },
    {
      "id": "natural-types",
      "title": "Renewable and Non-renewable Resources",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "Type",
            "Meaning",
            "Examples"
          ],
          "rows": [
            [
              "Renewable",
              "Replenished naturally over a relatively short period, when managed appropriately.",
              "Sunlight, wind"
            ],
            [
              "Non-renewable",
              "Available in finite amounts or formed over very long geological periods.",
              "Coal, petroleum"
            ]
          ]
        },
        {
          "type": "callout",
          "title": "Remember",
          "text": "Renewable does not always mean unlimited. Resources such as forests and freshwater can be depleted if used unsustainably."
        }
      ]
    },
    {
      "id": "conservation",
      "title": "Resource Conservation",
      "blocks": [
        {
          "type": "p",
          "text": "Resource conservation means using resources carefully and avoiding unnecessary waste so that they remain available in the future."
        },
        {
          "type": "list",
          "items": [
            "Reduce unnecessary consumption.",
            "Reuse products where practical.",
            "Recycle suitable materials.",
            "Protect forests, soil and water.",
            "Prefer renewable energy where feasible."
          ]
        },
        {
          "type": "def",
          "term": "Sustainable development",
          "text": "Development that meets present needs while protecting the ability of future generations to meet their own needs."
        }
      ]
    },
    {
      "id": "people-resources",
      "title": "People as Resource Creators",
      "blocks": [
        {
          "type": "p",
          "text": "People use knowledge, technology and skills to identify materials and make them useful. What counts as a resource can change as human needs and technology change."
        },
        {
          "type": "example",
          "title": "Think about it",
          "text": "A material that was difficult to use in the past may become useful after new technology is developed."
        }
      ]
    }
  ],
  "revision": {
    "takeaways": [
      "A resource has utility and value.",
      "Resources include natural, human-made and human resources.",
      "Natural resources may be renewable or non-renewable.",
      "Conservation reduces waste and protects future availability.",
      "Sustainable development considers both present and future needs."
    ],
    "summary": "Resources help satisfy human needs. Their usefulness depends on people, technology, accessibility and value. Careful use and conservation are important for sustainable development.",
    "flashcards": [
      {
        "q": "What is a resource?",
        "a": "Anything that can satisfy a human need when it is accessible, usable and acceptable."
      },
      {
        "q": "What are the three broad resource categories?",
        "a": "Natural, human-made and human resources."
      },
      {
        "q": "Give two renewable resource examples.",
        "a": "Sunlight and wind."
      },
      {
        "q": "Give two non-renewable resource examples.",
        "a": "Coal and petroleum."
      },
      {
        "q": "What is resource conservation?",
        "a": "Using resources carefully and avoiding unnecessary waste."
      },
      {
        "q": "What is sustainable development?",
        "a": "Meeting present needs without compromising future generations' ability to meet their needs."
      }
    ]
  },
  "questions": [
    {
      "id": "q1",
      "q": "Which of these is a human-made resource?",
      "options": [
        "Wind",
        "A bridge",
        "Sunlight",
        "A forest"
      ],
      "answer": 1,
      "why": "A bridge is constructed by people using materials and technology.",
      "ref": "Types of Resources"
    },
    {
      "id": "q2",
      "q": "Which is a renewable resource?",
      "options": [
        "Coal",
        "Petroleum",
        "Sunlight",
        "Natural gas"
      ],
      "answer": 2,
      "why": "Sunlight is continuously supplied by the Sun on human timescales.",
      "ref": "Renewable and Non-renewable Resources"
    },
    {
      "id": "q3",
      "q": "Which is a non-renewable resource?",
      "options": [
        "Wind",
        "Coal",
        "Sunlight",
        "Tidal energy"
      ],
      "answer": 1,
      "why": "Coal forms over geological timescales and is finite.",
      "ref": "Renewable and Non-renewable Resources"
    },
    {
      "id": "q4",
      "q": "What does utility mean?",
      "options": [
        "A resource's ability to satisfy a need",
        "A resource's colour",
        "A resource's location only",
        "A resource's age"
      ],
      "answer": 0,
      "why": "Utility is the capacity to satisfy a human need.",
      "ref": "Meaning of Resources"
    },
    {
      "id": "q5",
      "q": "Which action supports resource conservation?",
      "options": [
        "Wasting water",
        "Cutting all forests",
        "Reusing suitable products",
        "Leaving lights on unnecessarily"
      ],
      "answer": 2,
      "why": "Reuse can reduce waste and demand for new materials.",
      "ref": "Resource Conservation"
    },
    {
      "id": "q6",
      "q": "Which is an example of a human resource?",
      "options": [
        "A person's knowledge and skills",
        "A mineral deposit",
        "A river",
        "A road"
      ],
      "answer": 0,
      "why": "Knowledge and skills are human capabilities that help develop and use resources.",
      "ref": "Types of Resources"
    },
    {
      "id": "q7",
      "q": "Why is sustainable development important?",
      "options": [
        "It encourages unlimited waste",
        "It ignores future needs",
        "It balances present needs and future availability",
        "It stops all development"
      ],
      "answer": 2,
      "why": "Sustainable development considers present needs and future generations.",
      "ref": "Resource Conservation"
    },
    {
      "id": "q8",
      "q": "Which statement about renewable resources is correct?",
      "options": [
        "They can never be depleted",
        "They are replenished naturally, but some need careful management",
        "They are all fossil fuels",
        "They cannot be used to produce energy"
      ],
      "answer": 1,
      "why": "Some renewable resources can still be depleted if used faster than they recover.",
      "ref": "Renewable and Non-renewable Resources"
    }
  ],
  "sourceNote": "Original study notes prepared for revision; not a verbatim reproduction of the NCERT textbook. Check the prescribed textbook for exact chapter wording."
}
