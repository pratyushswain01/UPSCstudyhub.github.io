<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#171331">
<meta name="description" content="Contact UPSC गुरुकुल for website support, learning resources, feedback and data-related requests.">
<title>Contact Us | UPSC गुरुकुल</title>
<link rel="icon" href="/favicon.ico">
<style>
:root{color-scheme:dark;--bg:#100e20;--panel:#191630;--line:#343052;--text:#f7f5ff;--muted:#b9b4d2;--purple:#a78bfa;--cyan:#67e8f9}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 15% 0%,#35235d 0,transparent 42%),radial-gradient(ellipse at 100% 35%,#142c4a 0,transparent 35%),var(--bg);color:var(--text);font:16px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--cyan);text-underline-offset:4px}
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--cyan);outline-offset:3px}
.wrap{width:min(1100px,92%);margin:auto}
header{border-bottom:1px solid #ffffff18;background:#100e20a8}
.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:12px;color:var(--text);text-decoration:none;font-weight:800;font-size:18px}
.mark{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,#8b5cf6,#2563eb);box-shadow:0 8px 30px #7c3aed35;font-size:21px}
.navlinks{display:flex;gap:20px;flex-wrap:wrap;font-size:14px}
.navlinks a{color:var(--muted);text-decoration:none}
.navlinks a:hover{color:white}
.hero{padding:72px 0 42px;max-width:760px}
.eyebrow{color:var(--cyan);font-size:12px;font-weight:800;letter-spacing:2.4px;text-transform:uppercase}
h1{font-size:clamp(38px,6vw,66px);line-height:1.08;letter-spacing:-2px;margin:16px 0}
.gradient{background:linear-gradient(100deg,#c4b5fd,#67e8f9);background-clip:text;-webkit-background-clip:text;color:transparent}
.hero p{color:var(--muted);font-size:18px;max-width:650px}
.layout{display:grid;grid-template-columns:.85fr 1.15fr;gap:22px;padding-bottom:64px}
.card{background:linear-gradient(145deg,#201b3bdf,#151529f5);border:1px solid var(--line);border-radius:24px;padding:clamp(22px,4vw,34px);box-shadow:0 20px 65px #0002}
h2{font-size:23px;line-height:1.25;margin:0 0 10px}
.intro{color:var(--muted);margin:0 0 24px}
.contact-item{display:flex;gap:14px;padding:18px 0;border-bottom:1px solid #ffffff12}
.contact-item:last-of-type{border-bottom:0}
.symbol{flex:none;display:grid;place-items:center;width:43px;height:43px;border-radius:14px;background:#a78bfa18;border:1px solid #a78bfa35;font-size:20px}
.contact-item strong{display:block;margin-bottom:3px}
.contact-item p{margin:0;color:var(--muted);font-size:14px}
.contact-item a{overflow-wrap:anywhere}
.note{margin-top:20px;padding:15px;border-radius:14px;background:#67e8f90b;border:1px solid #67e8f926;color:var(--muted);font-size:13px}
label{display:block;font-weight:650;font-size:14px;margin:17px 0 7px}
input,select,textarea{display:block;width:100%;border:1px solid #45405f;border-radius:12px;background:#100e20;color:var(--text);font:inherit;padding:13px 14px}
input::placeholder,textarea::placeholder{color:#827d9f}
textarea{min-height:145px;resize:vertical}
button{width:100%;margin-top:22px;border:0;border-radius:13px;padding:15px 20px;background:linear-gradient(100deg,#8b5cf6,#2563eb);color:white;font:inherit;font-weight:800;cursor:pointer}
button:hover{filter:brightness(1.12)}
.small{font-size:12px;color:var(--muted);margin:12px 0 0}
.links{display:flex;gap:18px;flex-wrap:wrap;margin-top:20px;font-size:14px}
footer{border-top:1px solid #ffffff18;padding:25px 0 35px;color:var(--muted);font-size:13px}
.foot{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap}
@media(max-width:760px){.nav{align-items:flex-start;padding:15px 0;flex-direction:column}.navlinks{gap:14px}.hero{padding-top:48px}.layout{grid-template-columns:1fr}.card{border-radius:19px}h1{letter-spacing:-1.3px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header>
<div class="wrap nav">
<a class="brand" href="/" aria-label="UPSC Gurukul home"><span class="mark" aria-hidden="true">गु</span><span>UPSC गुरुकुल</span></a>
<nav class="navlinks" aria-label="Main navigation">
<a href="/">Home</a><a href="/privacy.html">Privacy</a><a href="/data-rights.html">Data Rights</a>
</nav>
</div>
</header>
<main class="wrap">
<section class="hero">
<div class="eyebrow">We're here to help</div>
<h1>Let's make your<br><span class="gradient">journey easier.</span></h1>
<p>Have a question about UPSC गुरुकुल, learning resources, technical issues or your personal data? Send us a message and tell us how we can help.</p>
</section>
<section class="layout" aria-label="Contact information and message form">
<div class="card">
<h2>Get in touch</h2>
<p class="intro">Choose the contact method that works best for you.</p>
<div class="contact-item">
<span class="symbol" aria-hidden="true">✉</span>
<div><strong>Email support</strong><p>For questions, feedback and assistance.</p><a href="mailto:email@pratyushswain.in">email@pratyushswain.in</a></div>
</div>
<div class="contact-item">
<span class="symbol" aria-hidden="true">☎</span>
<div><strong>Phone</strong><p>For direct enquiries.</p><a href="tel:+918249395283">+91 82493 95283</a></div>
</div>
<div class="contact-item">
<span class="symbol" aria-hidden="true">🔐</span>
<div><strong>Privacy and data requests</strong><p>For access, correction, deletion or privacy questions.</p><a href="/data-rights.html">Visit Data Rights</a></div>
</div>
<div class="note">Please do not include passwords, OTPs, authentication tokens or other sensitive account credentials in your message.</div>
<div class="links"><a href="/privacy.html">Privacy Notice</a><a href="/terms.html">Terms of Use</a></div>
</div>
<div class="card">
<h2>Send us a message</h2>
<p class="intro">Complete the fields below. Your email app will open with your message ready to review.</p>
<form id="contactForm">
<label for="name">Your name</label>
<input id="name" name="name" autocomplete="name" maxlength="100" required placeholder="Enter your name">
<label for="email">Your email address</label>
<input id="email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com">
<label for="topic">What can we help with?</label>
<select id="topic" name="topic" required>
<option value="" selected disabled>Select a topic</option>
<option>Website or technical support</option>
<option>Learning resources or tests</option>
<option>Feedback or suggestion</option>
<option>Privacy or personal data request</option>
<option>Other enquiry</option>
</select>
<label for="message">Your message</label>
<textarea id="message" name="message" maxlength="5000" required placeholder="Describe your question or issue..."></textarea>
<button type="submit">Prepare email ↗</button>
<p class="small">This form does not submit to a server or store your message. Your email application must be configured to continue.</p>
<p id="formStatus" class="small" role="status" aria-live="polite"></p>
</form>
</div>
</section>
</main>
<footer><div class="wrap foot"><span>© <span id="year"></span> UPSC गुरुकुल. Learn with purpose.</span><span>Built for aspirants, one step at a time.</span></div></footer>
<script>
"use strict";
document.getElementById("year").textContent = new Date().getFullYear();
document.getElementById("contactForm").addEventListener("submit", function(event) {
  event.preventDefault();
  if (!this.reportValidity()) return;
  const name = document.getElementById("name").value.trim();
  const email = document.getElementById("email").value.trim();
  const topic = document.getElementById("topic").value;
  const message = document.getElementById("message").value.trim();
  if (!name || !email || !topic || !message) return;
  const subject = "[UPSC Gurukul] " + topic;
  const body = "Name: " + name + "\nReply email: " + email + "\nTopic: " + topic + "\n\nMessage:\n" + message;
  document.getElementById("formStatus").textContent = "Opening your email application. Review the message and send it there.";
  window.location.href = "mailto:email@pratyushswain.in?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
});
</script>
</body>
</html>